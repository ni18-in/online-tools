---
/**
 * BlogLayout.astro — MD3 shell around a preserved blog article. Slot-based: the post page
 * supplies the legacy <main> article (set:html) wrapped in .blog-island.legacy-tw (blogs used
 * Tailwind), plus its scoped <style>. A reserved-height ad sits below the article.
 */
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import type { Props as SeoProps } from '../components/Seo.astro';
import { type Locale } from '../data/i18n';
import '../styles/tw-preflight-scoped.css';

export interface Props {
  seo: SeoProps;
  lang?: Locale;
  altLinks?: Partial<Record<Locale, string>>;
  headRaw?: string;
  ad?: boolean;
}
const { seo, lang = 'en', altLinks = {}, headRaw, ad = true } = Astro.props;
---
<BaseLayout seo={seo} lang={lang} current="blogs" altLinks={altLinks} headRaw={headRaw} adsEnabled={ad}>
  <div class="blog-shell">
    <slot />
    {ad && <AdSlot placement="below-content" minHeight={250} class="blog-ad" />}
  </div>
</BaseLayout>

<style>
  .blog-shell { max-width: 920px; margin: 0 auto; padding: 8px 16px 0; box-sizing: border-box; }
  .blog-ad { margin: 32px auto; max-width: min(728px, 100%); }
  /* Blog articles adapt to the theme surface */
  :global(.blog-island.legacy-tw) {
    background: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-large);
    border: 1px solid var(--md-sys-color-outline-variant);
    overflow: hidden;
  }
  :global(:root[data-theme='dark'] .blog-island h1),
  :global(:root[data-theme='dark'] .blog-island h2),
  :global(:root[data-theme='dark'] .blog-island h3),
  :global(:root[data-theme='dark'] .blog-island strong) {
    color: var(--md-sys-color-on-surface);
  }
  :global(:root[data-theme='dark'] .blog-island p),
  :global(:root[data-theme='dark'] .blog-island li) {
    color: var(--md-sys-color-on-surface-variant);
  }
  :global(:root[data-theme='dark'] .blog-island a) {
    color: var(--md-sys-color-primary);
  }
  :global(:root[data-theme='dark'] .blog-island pre),
  :global(:root[data-theme='dark'] .blog-island code) {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }
  :global(.blog-island img) { max-width: 100%; height: auto; }
</style>
