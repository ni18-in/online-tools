---
/**
 * BaseLayout.astro — the document shell every page uses.
 * Head: charset/viewport, favicons + manifest, theme-color, Roboto (MD3), the design-token
 * + Tailwind stylesheets, ThemeNoFlash (pre-paint), Analytics (GA4), <Seo>, an optional
 * verbatim head escape-hatch (`headRaw`, for a tool's exact CDN deps), and the AdSense loader
 * when ads are enabled. Body: sticky header + <slot/> + footer. MWC is a deferred module.
 */
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import ThemeNoFlash from '../components/ThemeNoFlash.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { type Locale } from '../data/i18n';
import { ADSENSE_CLIENT, SITE_URL, GSC_VERIFICATION } from '../data/site';
import { tools } from '../data/tools';
import { blogPosts } from '../data/blogs';
import '../styles/md3-tokens.css';
import '../styles/tailwind.css';

export interface Props {
  seo: SeoProps;
  lang?: Locale;
  current?: 'home' | 'tools' | 'blogs' | 'about';
  altLinks?: Partial<Record<Locale, string>>;
  /** Verbatim HTML injected into <head> (a tool's exact CDN <link>/<script> deps). */
  headRaw?: string;
  /** Load the AdSense library (pages that render <AdSlot>). */
  adsEnabled?: boolean;
  bodyClass?: string;
}

const {
  seo,
  lang = 'en',
  current,
  altLinks = {},
  headRaw,
  adsEnabled = false,
  bodyClass,
} = Astro.props;

// Auto-populate altLinks if they are missing
let resolvedAltLinks = { ...altLinks };
if (seo.canonical) {
  const canonical = seo.canonical;
  const matchingTool = tools.find((t) => {
    if (canonical.includes(`/tools/${t.slug}/`)) return true;
    if (t.i18n?.es && canonical.includes(`/tools/${t.i18n.es}/`)) return true;
    if (t.i18n?.fr && canonical.includes(`/tools/${t.i18n.fr}/`)) return true;
    return false;
  });

  if (matchingTool) {
    if (!resolvedAltLinks.en) {
      resolvedAltLinks.en = `${SITE_URL}/tools/${matchingTool.slug}/`;
    }
    if (matchingTool.i18n?.es && !resolvedAltLinks.es) {
      resolvedAltLinks.es = `${SITE_URL}/es/tools/${matchingTool.i18n.es}/`;
    }
    if (matchingTool.i18n?.fr && !resolvedAltLinks.fr) {
      resolvedAltLinks.fr = `${SITE_URL}/fr/tools/${matchingTool.i18n.fr}/`;
    }
  } else {
    const matchingBlog = blogPosts.find((p) => {
      if (canonical.includes(`/blogs/${p.slug}.html`)) return true;
      if (p.i18n?.es && canonical.includes(`/blogs/${p.i18n.es.slug}.html`)) return true;
      if (p.i18n?.fr && canonical.includes(`/blogs/${p.i18n.fr.slug}.html`)) return true;
      return false;
    });

    if (matchingBlog) {
      if (!resolvedAltLinks.en) {
        resolvedAltLinks.en = `${SITE_URL}/blogs/${matchingBlog.slug}.html`;
      }
      if (matchingBlog.i18n?.es && !resolvedAltLinks.es) {
        resolvedAltLinks.es = `${SITE_URL}/es/blogs/${matchingBlog.i18n.es.slug}.html`;
      }
      if (matchingBlog.i18n?.fr && !resolvedAltLinks.fr) {
        resolvedAltLinks.fr = `${SITE_URL}/fr/blogs/${matchingBlog.i18n.fr.slug}.html`;
      }
    }
  }
}
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#4f46e5" />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/icons/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
      />
    </noscript>

    <ThemeNoFlash />
    <Analytics />
    <Seo {...seo} />

    {adsEnabled && (
      <>
        <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
        <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
        <link rel="preconnect" href="https://googleads.g.doubleclick.net" />
        <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net" />
        <link rel="preconnect" href="https://adservice.google.com" />
        <link rel="dns-prefetch" href="https://adservice.google.com" />
      </>
    )}

    {adsEnabled && import.meta.env.PROD && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"></script>
    )}

    {headRaw && <Fragment set:html={headRaw} />}
  </head>
  <body class={bodyClass}>
    <div class="site-shell">
      <SiteHeader lang={lang} current={current} altLinks={resolvedAltLinks} />
      <slot />
      <SiteFooter lang={lang} />
    </div>

    <div id="global-snackbar" class="md3-snackbar" popover="manual" role="status" aria-live="polite" aria-atomic="true">
      <span id="global-snackbar-text" class="md3-snackbar__text"></span>
      <button id="global-snackbar-action" type="button" class="md3-snackbar__action" hidden></button>
    </div>

    <script is:inline>
      (function () {
        var snackbar = document.getElementById('global-snackbar');
        var textEl = document.getElementById('global-snackbar-text');
        var actionBtn = document.getElementById('global-snackbar-action');
        var pendingDuration = 4000;

        function hideToast() {
          if (!snackbar) return;
          if (typeof snackbar.hidePopover === 'function') {
            try { snackbar.hidePopover(); } catch (e) {}
          }
          snackbar.classList.remove('md3-snackbar--active');
        }

        function scheduleHide(duration) {
          if (window.snackbarTimer) clearTimeout(window.snackbarTimer);
          window.snackbarTimer = setTimeout(function () {
            if (snackbar && snackbar.matches(':focus-within')) return;
            hideToast();
          }, duration);
        }

        if (snackbar) {
          snackbar.addEventListener('focusout', function () {
            if (!snackbar.matches(':focus-within') && (snackbar.classList.contains('md3-snackbar--active') || (snackbar.matches && snackbar.matches(':popover-open')))) {
              scheduleHide(pendingDuration);
            }
          });
        }

        window.showToast = function (message, duration, actionText, actionCallback) {
          if (duration === void 0) duration = 4000;
          if (!snackbar || !textEl) return;
          pendingDuration = duration;
          textEl.textContent = message;

          if (actionBtn) {
            if (actionText && actionCallback) {
              actionBtn.textContent = actionText;
              actionBtn.hidden = false;
              actionBtn.onclick = function () {
                actionCallback();
                hideToast();
              };
            } else {
              actionBtn.hidden = true;
              actionBtn.onclick = null;
            }
          }

          if (typeof snackbar.showPopover === 'function') {
            try { snackbar.showPopover(); } catch (e) {}
          }
          snackbar.classList.add('md3-snackbar--active');
          scheduleHide(duration);
        };

        // Intercept legacy window.alert calls
        window.alert = function (message) {
          window.showToast(String(message));
        };
      })();
    </script>

    <style is:global>
      .md3-snackbar {
        position: fixed;
        inset: auto auto 24px 50%;
        margin: 0;
        border: 0;
        transform: translateX(-50%) translateY(100px);
        background-color: var(--md-sys-color-inverse-surface, #313033);
        color: var(--md-sys-color-inverse-on-surface, #f4f0f4);
        padding: 14px 16px;
        border-radius: 8px;
        box-shadow: 0px 3px 5px -1px rgba(0,0,0,0.2), 0px 6px 10px 0px rgba(0,0,0,0.14), 0px 1px 18px 0px rgba(0,0,0,0.12);
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 288px;
        max-width: min(568px, calc(100vw - 32px));
        z-index: 9999;
        transition: transform 0.25s cubic-bezier(0, 0, 0.2, 1), opacity 0.25s ease;
        opacity: 0;
        pointer-events: none;
      }

      .md3-snackbar:is(:popover-open, .md3-snackbar--active) {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
        pointer-events: auto;
      }

      .md3-snackbar__text {
        flex-grow: 1;
        font-size: 0.875rem;
        line-height: 1.43;
        letter-spacing: 0.01786em;
      }

      .md3-snackbar__action {
        background: none;
        border: none;
        color: var(--md-sys-color-inverse-primary, #d0bcff);
        font-weight: 500;
        font-size: 0.875rem;
        cursor: pointer;
        padding: 4px 8px;
        text-transform: uppercase;
      }
      .md3-snackbar__action[hidden] { display: none; }
    </style>

    <!-- Speculative prefetch for instant same-origin MPA navigations (progressive enhancement). -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/404.html" } },
                { "not": { "selector_matches": "[rel~=nofollow]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Material Web Components: deferred module, never blocks first paint. -->
    <script>
      import '../scripts/md3.ts';
    </script>

    <!-- Offline Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('SW registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>
