---
/**
 * ToolLayout.astro — MD3 shell around a preserved tool.
 *
 * The tool's markup goes in the page's <slot> wrapped in `.tool-island` (Tailwind tools add
 * `.legacy-tw` for the scoped Preflight). The page keeps the tool's CSS in an Astro scoped
 * <style> (auto-isolated → cannot leak into the shell or other tools) and its JS in an
 * is:inline <script> (verbatim, untouched). CDN libs/fonts a tool needs go in `headRaw`;
 * external tool scripts (script.js) in `scriptSrcs`.
 */
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import type { Props as SeoProps } from '../components/Seo.astro';
import { type Locale, LOCALE_BASE, NAV_LABELS } from '../data/i18n';
import { tools } from '../data/tools';
import '../styles/tw-preflight-scoped.css';

export interface Props {
  seo: SeoProps;
  lang?: Locale;
  altLinks?: Partial<Record<Locale, string>>;
  headRaw?: string;
  scriptSrcs?: string[];
  ad?: boolean;
  adMinHeight?: number;
  /** Load Google Material Icons font (only needed by legacy tools that use the icon font). */
  materialIcons?: boolean;
  /**
   * Visually-hidden <h1> for tools whose own markup starts at <h2>. Every page needs exactly
   * one h1 for SEO/a11y; pass this ONLY when the tool body has none, or you create a second.
   * verify-build.mjs enforces the exactly-one rule, so a mistake here fails the build.
   */
  h1?: string;
}
const {
  seo,
  lang = 'en',
  altLinks = {},
  headRaw,
  scriptSrcs = [],
  ad = true,
  adMinHeight = 280,
  materialIcons = false,
  h1,
} = Astro.props;

// Only load Material Icons font when a tool actually uses the icon font (screen-recorder-pro, online-text-compare).
const materialIconsLink = materialIcons ? '\n<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />' : '';
const finalHeadRaw = (headRaw || '') + materialIconsLink;

const navLabels = NAV_LABELS[lang];
const base = LOCALE_BASE[lang];

const currentCanonical = seo.canonical || '';
const currentTool = tools.find((t) => {
  if (currentCanonical.includes(`/tools/${t.slug}/`)) return true;
  if (t.i18n?.es && currentCanonical.includes(`/tools/${t.i18n.es}/`)) return true;
  if (t.i18n?.fr && currentCanonical.includes(`/tools/${t.i18n.fr}/`)) return true;
  return false;
});

const toolName = currentTool ? currentTool.name : (h1 || seo.title.split('–')[0].split('|')[0].trim());

const relatedTools = currentTool
  ? tools
      .filter((t) => {
        if (t.category !== currentTool.category || t.slug === currentTool.slug || t.inSitemap === false) return false;
        if (lang === 'es' && !t.i18n?.es) return false;
        if (lang === 'fr' && !t.i18n?.fr) return false;
        return true;
      })
      .slice(0, 3)
  : [];
---
<BaseLayout seo={seo} lang={lang} current="tools" altLinks={altLinks} headRaw={finalHeadRaw} adsEnabled={ad}>
  <main id="main-content" class="tool-main">
    {h1 && <h1 class="sr-only">{h1}</h1>}

    <nav class="tool-breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={base}>{navLabels.home}</a></li>
        <li class="crumb-sep" aria-hidden="true">/</li>
        <li><a href={`${base}tools/`}>{navLabels.tools}</a></li>
        <li class="crumb-sep" aria-hidden="true">/</li>
        <li class="crumb-current" aria-current="page">{toolName}</li>
      </ol>
    </nav>

    <slot />

    {relatedTools.length > 0 && (
      <aside class="related-tools" aria-label="Related tools">
        <h2 class="related-title">
          {lang === 'es' ? 'Herramientas Relacionadas' : lang === 'fr' ? 'Outils Connexes' : 'Related Tools'}
        </h2>
        <div class="related-grid">
          {relatedTools.map((rt) => {
            const locSlug = lang === 'es' && rt.i18n?.es ? rt.i18n.es : (lang === 'fr' && rt.i18n?.fr ? rt.i18n.fr : rt.slug);
            const href = `${base}tools/${locSlug}/`;
            return (
              <a href={href} class="related-card">
                <span class="related-name">{rt.name}</span>
                <span class="related-desc">{rt.description}</span>
              </a>
            );
          })}
        </div>
      </aside>
    )}

    {scriptSrcs.map((src) => <script is:inline src={src}></script>)}
    {ad && <AdSlot placement="below-content" minHeight={adMinHeight} class="tool-ad" />}
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    function sync() {
      var isDark = document.documentElement.dataset.theme === 'dark';
      document.body.classList.toggle('dark-mode', isDark);
      document.body.classList.toggle('dark', isDark);
      
      var tool = document.querySelector('.tool-island');
      if (tool) {
        tool.classList.toggle('dark-mode', isDark);
        tool.classList.toggle('dark', isDark);
      }
    }
    sync();
    var obs = new MutationObserver(sync);
    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>

<style>
  /* Hide duplicate theme toggle buttons inside legacy tools */
  .tool-main :global(#themeToggleBtn),
  .tool-main :global(#darkModeToggle),
  .tool-main :global(.dark-mode-toggle),
  .tool-main :global(#theme-toggle),
  .tool-main :global(#theme-btn),
  .tool-main :global(.theme-toggle) {
    display: none !important;
  }

  /* width:100% defeats the flex shrink-wrap (a column flex item with auto cross-margins
     collapses to content width) so every tool gets the full page width to lay out in.
     box-sizing:border-box keeps padding INSIDE that 100% so .tool-main never exceeds the
     viewport on narrow screens (was 360+32px=392px → horizontal overflow before). */
  .tool-main {
    width: 100%;
    box-sizing: border-box;
    padding: 24px 16px 8px;
  }

  /* Breadcrumbs */
  .tool-breadcrumbs {
    max-width: 1080px;
    margin: 0 auto 16px;
    font-size: 0.875rem;
    color: var(--md-sys-color-on-surface-variant);
  }
  .tool-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tool-breadcrumbs a {
    color: var(--md-sys-color-primary);
    text-decoration: none;
    transition: opacity .15s;
  }
  .tool-breadcrumbs a:hover { text-decoration: underline; }
  .crumb-sep { opacity: 0.5; }
  .crumb-current {
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 320px;
  }

  /* Related Tools */
  .related-tools {
    max-width: 1080px;
    margin: 40px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }
  .related-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 16px;
    color: var(--md-sys-color-on-surface);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    text-decoration: none;
    color: inherit;
    transition: transform .15s, box-shadow .15s, border-color .15s;
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--md-sys-elevation-1);
    border-color: var(--md-sys-color-primary);
  }
  .related-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--md-sys-color-primary);
    margin-bottom: 6px;
  }
  .related-desc {
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-ad { margin: 28px auto 0; max-width: min(728px, 100%); }
  /* One consistent MD3 work-surface for EVERY tool: centered, capped width, themed card.
     The extractor strips each tool's own page background, so this is the single canvas.
     A few intentionally-themed islands (dark basic-auth, gradient AI tools) override the bg
     in their own page via utility classes. */
  :global(.tool-island) {
    max-width: 1080px;
    margin: 0 auto;
    box-sizing: border-box;
    /* Soft neutral canvas — tools with their own dark/branded bg override via #tool-<slug>;
       tools without one get this. No border/shadow so it never double-frames a tool's own cards. */
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: clamp(12px, 2vw, 28px);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  :global(.tool-island *),
  :global(.tool-island *::before),
  :global(.tool-island *::after) {
    box-sizing: border-box;
  }

  :global(.tool-island img),
  :global(.tool-island video),
  :global(.tool-island canvas),
  :global(.tool-island svg) {
    max-width: 100%;
  }

  :global(.tool-island textarea),
  :global(.tool-island input),
  :global(.tool-island select),
  :global(.tool-island button) {
    max-width: 100%;
    min-width: 0;
  }

  :global(.tool-island pre),
  :global(.tool-island code),
  :global(.tool-island .diff-output),
  :global(.tool-island .output),
  :global(.tool-island .result),
  :global(.tool-island .results),
  :global(.tool-island .tree-view) {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  :global(.tool-island table) {
    max-width: 100%;
  }

  :global(.tool-island .container),
  :global(.tool-island .workspace),
  :global(.tool-island .panel),
  :global(.tool-island .card),
  :global(.tool-island .grid),
  :global(.tool-island [class*="grid"]),
  :global(.tool-island [class*="flex"]) {
    min-width: 0;
  }

  @media (max-width: 640px) {
    .tool-main {
      padding: 12px 8px 4px;
    }

    :global(.tool-island) {
      max-width: calc(100vw - 16px);
      border-radius: var(--md-sys-shape-corner-large);
      padding: 12px;
      overflow-x: clip;
    }

    :global(.tool-island h1) {
      font-size: clamp(1.5rem, 8vw, 2rem);
      line-height: 1.15;
    }

    :global(.tool-island h2) {
      font-size: clamp(1.25rem, 6vw, 1.5rem);
      line-height: 1.2;
    }

    :global(.tool-island table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    :global(.tool-island .assignment-row-grid) {
      grid-template-columns: minmax(0, 1fr) minmax(72px, .45fr) 10px minmax(72px, .45fr) 40px;
    }

    :global(#tool-advance-epoch-converter .dashboard),
    :global(#tool-advance-epoch-converter .results-grid),
    :global(#tool-advance-epoch-converter .card-grid-2) {
      grid-template-columns: 1fr;
    }

    :global(#tool-advance-epoch-converter .smart-input-container) {
      align-items: stretch;
      flex-direction: column;
    }

    :global(#tool-advance-epoch-converter #convert-btn) {
      width: 100%;
    }

    :global(#tool-vtf-converter div:has(> #resize-option)) {
      align-items: stretch;
      flex-direction: column;
      gap: .5rem;
    }

    :global(#tool-vtf-converter #resize-option) {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    :global(.tool-island .assignment-row-grid) {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
