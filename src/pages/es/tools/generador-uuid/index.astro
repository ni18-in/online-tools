<script is:inline>
  (function () {
    const idTypeSelect = document.getElementById('id-type');
    const idCountInput = document.getElementById('id-count');
    const nanoidWrap = document.getElementById('nanoid-length-wrap');
    const nanoidLengthInput = document.getElementById('nanoid-length');
    const optUppercase = document.getElementById('opt-uppercase');
    const optHyphens = document.getElementById('opt-hyphens');
    const optQuotes = document.getElementById('opt-quotes');
    const btnGenerate = document.getElementById('btn-generate');
    const btnSample = document.getElementById('btn-sample');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const btnDownloadTxt = document.getElementById('btn-download-txt');
    const btnDownloadJson = document.getElementById('btn-download-json');
    const outputText = document.getElementById('output-text');
    const outputCountBadge = document.getElementById('output-count-badge');
    const inspectInput = document.getElementById('inspect-input');
    const inspFormat = document.getElementById('insp-format');
    const inspDate = document.getElementById('insp-date');
    const inspEpoch = document.getElementById('insp-epoch');
    const statusError = document.getElementById('status-error');

    const STORAGE_KEY = 'onlineTools_uuidGeneratorInput';

    const CROCKFORD_32 = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
    const NANOID_ALPHABET = 'useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_ghz4182';

    function getRandomBytes(size) {
      const bytes = new Uint8Array(size);
      window.crypto.getRandomValues(bytes);
      return bytes;
    }

    function generateUUIDv4() {
      if (typeof window.crypto.randomUUID === 'function') {
        return window.crypto.randomUUID();
      }
      const bytes = getRandomBytes(16);
      bytes[6] = (bytes[6] & 0x0f) | 0x40;
      bytes[8] = (bytes[8] & 0x3f) | 0x80;
      return bytesToHexUUID(bytes);
    }

    function generateUUIDv7() {
      const bytes = getRandomBytes(16);
      const now = Date.now();
      const hexTime = now.toString(16).padStart(12, '0');
      for (let i = 0; i < 6; i++) {
        bytes[i] = parseInt(hexTime.slice(i * 2, i * 2 + 2), 16);
      }
      bytes[6] = (bytes[6] & 0x0f) | 0x70;
      bytes[8] = (bytes[8] & 0x3f) | 0x80;
      return bytesToHexUUID(bytes);
    }

    function bytesToHexUUID(bytes) {
      const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
      return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
    }

    function generateULID() {
      const now = Date.now();
      let timeStr = '';
      let timeVal = now;
      for (let i = 9; i >= 0; i--) {
        const mod = timeVal % 32;
        timeStr = CROCKFORD_32[mod] + timeStr;
        timeVal = Math.floor(timeVal / 32);
      }
      const randBytes = getRandomBytes(10);
      let randStr = '';
      for (let i = 0; i < 16; i++) {
        const randIndex = randBytes[i % 10] % 32;
        randStr += CROCKFORD_32[randIndex];
      }
      return timeStr + randStr;
    }

    function generateNanoID(len = 21) {
      const bytes = getRandomBytes(len);
      let id = '';
      for (let i = 0; i < len; i++) {
        id += NANOID_ALPHABET[bytes[i] % NANOID_ALPHABET.length];
      }
      return id;
    }

    function generateBatch() {
      try {
        statusError.style.display = 'none';
        const type = idTypeSelect.value;
        const count = Math.min(Math.max(parseInt(idCountInput.value, 10) || 1, 1), 500);
        const nanoidLen = Math.min(Math.max(parseInt(nanoidLengthInput.value, 10) || 21, 6), 64);
        const isUpper = optUppercase.checked;
        const keepHyphens = optHyphens.checked;
        const isQuotes = optQuotes.checked;

        const results = [];
        for (let i = 0; i < count; i++) {
          let id = '';
          if (type === 'v4') id = generateUUIDv4();
          else if (type === 'v7') id = generateUUIDv7();
          else if (type === 'ulid') id = generateULID();
          else if (type === 'nanoid') id = generateNanoID(nanoidLen);

          if ((type === 'v4' || type === 'v7') && !keepHyphens) {
            id = id.replace(/-/g, '');
          }
          if (isUpper) id = id.toUpperCase();
          else if (type !== 'nanoid' && type !== 'ulid') id = id.toLowerCase();

          if (isQuotes) id = `"${id}"`;
          results.push(id);
        }

        outputText.value = results.join('\n');
        outputCountBadge.textContent = `${results.length} ID${results.length > 1 ? 's' : ''} generados`;
        saveState();
      } catch (e) {
        statusError.style.display = 'block';
      }
    }

    function parseUUIDv7Timestamp(uuidStr) {
      const clean = uuidStr.replace(/-/g, '').trim();
      if (clean.length !== 32 || clean[12] !== '7') return null;
      const timeHex = clean.slice(0, 12);
      const epochMs = parseInt(timeHex, 16);
      if (isNaN(epochMs)) return null;
      return epochMs;
    }

    function parseULIDTimestamp(ulidStr) {
      const clean = ulidStr.trim().toUpperCase();
      if (clean.length !== 26) return null;
      const timePart = clean.slice(0, 10);
      let epochMs = 0;
      for (let i = 0; i < timePart.length; i++) {
        const char = timePart[i];
        const idx = CROCKFORD_32.indexOf(char);
        if (idx === -1) return null;
        epochMs = epochMs * 32 + idx;
      }
      return epochMs;
    }

    function inspectID() {
      const val = inspectInput.value.trim();
      if (!val) {
        inspFormat.textContent = 'Ninguno';
        inspDate.textContent = '-';
        inspEpoch.textContent = '-';
        return;
      }

      let epoch = parseUUIDv7Timestamp(val);
      if (epoch !== null) {
        inspFormat.textContent = 'UUID v7';
        inspEpoch.textContent = `${epoch} ms`;
        inspDate.textContent = new Date(epoch).toUTCString();
        return;
      }

      epoch = parseULIDTimestamp(val);
      if (epoch !== null) {
        inspFormat.textContent = 'ULID';
        inspEpoch.textContent = `${epoch} ms`;
        inspDate.textContent = new Date(epoch).toUTCString();
        return;
      }

      if (/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(val)) {
        inspFormat.textContent = 'UUID v4 (Aleatorio - Sin fecha)';
        inspEpoch.textContent = 'N/A';
        inspDate.textContent = 'N/A';
        return;
      }

      inspFormat.textContent = 'Desconocido / Inválido';
      inspEpoch.textContent = '-';
      inspDate.textContent = '-';
    }

    function saveState() {
      const state = {
        type: idTypeSelect.value,
        count: idCountInput.value,
        nanoidLen: nanoidLengthInput.value,
        upper: optUppercase.checked,
        hyphens: optHyphens.checked,
        quotes: optQuotes.checked,
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {}
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const state = JSON.parse(raw);
        if (state.type) idTypeSelect.value = state.type;
        if (state.count) idCountInput.value = state.count;
        if (state.nanoidLen) nanoidLengthInput.value = state.nanoidLen;
        if (typeof state.upper === 'boolean') optUppercase.checked = state.upper;
        if (typeof state.hyphens === 'boolean') optHyphens.checked = state.hyphens;
        if (typeof state.quotes === 'boolean') optQuotes.checked = state.quotes;
      } catch (e) {}
    }

    idTypeSelect.addEventListener('change', () => {
      nanoidWrap.style.display = idTypeSelect.value === 'nanoid' ? 'block' : 'none';
      generateBatch();
    });

    idCountInput.addEventListener('input', generateBatch);
    nanoidLengthInput.addEventListener('input', generateBatch);
    optUppercase.addEventListener('change', generateBatch);
    optHyphens.addEventListener('change', generateBatch);
    optQuotes.addEventListener('change', generateBatch);
    btnGenerate.addEventListener('click', generateBatch);

    btnSample.addEventListener('click', () => {
      idTypeSelect.value = 'v7';
      nanoidWrap.style.display = 'none';
      idCountInput.value = '5';
      optUppercase.checked = false;
      optHyphens.checked = true;
      optQuotes.checked = false;
      generateBatch();
      if (outputText.value) {
        inspectInput.value = outputText.value.split('\n')[0];
        inspectID();
      }
    });

    btnClear.addEventListener('click', () => {
      outputText.value = '';
      inspectInput.value = '';
      outputCountBadge.textContent = '0 IDs generados';
      inspectID();
    });

    btnCopy.addEventListener('click', () => {
      if (!outputText.value) return;
      navigator.clipboard.writeText(outputText.value).then(() => {
        if (window.showToast) window.showToast('¡Copiado al portapapeles!');
      });
    });

    btnDownloadTxt.addEventListener('click', () => {
      if (!outputText.value) return;
      const blob = new Blob([outputText.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ids-${idTypeSelect.value}-${Date.now()}.txt`;
      a.click();
      URL.revokeObjectURL(url);
    });

    btnDownloadJson.addEventListener('click', () => {
      if (!outputText.value) return;
      const list = outputText.value.split('\n').filter(Boolean);
      const blob = new Blob([JSON.stringify(list, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `ids-${idTypeSelect.value}-${Date.now()}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    inspectInput.addEventListener('input', inspectID);

    loadState();
    nanoidWrap.style.display = idTypeSelect.value === 'nanoid' ? 'block' : 'none';
    generateBatch();
  })();
</script>
