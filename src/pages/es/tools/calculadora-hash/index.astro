---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import { getTool, toolSeo, makeFaqSchema, makeHowToSchema } from '../../../../data/tools';
import { SITE_URL } from '../../../../data/site';

const tool = getTool('hash-calculator')!;

const steps = [
  {
    title: 'Selecciona el modo de entrada (Texto o Archivo)',
    description: 'Elige si deseas calcular hashes para una cadena de texto o generar sumas de comprobación directamente desde archivos locales.',
  },
  {
    title: 'Ingresa el texto o arrastra un archivo',
    description: 'Escribe tu texto o suelta cualquier archivo en el área interactiva. Todo se procesa en la memoria del navegador con FileReader y ArrayBuffers.',
  },
  {
    title: 'Configura HMAC o verificación de checksum',
    description: 'Opcionalmente activa la generación HMAC con clave secreta o pega un hash esperado para comprobar coincidencias automáticamente.',
  },
  {
    title: 'Copia los hashes generados',
    description: 'Visualiza de inmediato los resultados en SHA-256, SHA-512, SHA-384, SHA-1 y MD5. Alterna formatos (hexadecimal o Base64) y copia con un solo clic.',
  },
];

const faqSchema = makeFaqSchema([
  {
    question: '¿Mis datos y archivos son privados y seguros?',
    answer: 'Sí, 100%. Todos los cálculos de hash se realizan localmente en la memoria de tu navegador mediante la Web Crypto API (`crypto.subtle`) y JavaScript del lado del cliente. Ningún dato se sube a servidores remotos.',
  },
  {
    question: '¿Puedo calcular el checksum de archivos grandes?',
    answer: 'Sí. El procesador de archivos lee el contenido mediante flujos nativos ArrayBuffer en el navegador, por lo que la velocidad depende únicamente de la potencia de tu equipo.',
  },
  {
    question: '¿Cuál es la diferencia entre SHA-256 y MD5?',
    answer: 'SHA-256 forma parte de la familia SHA-2 con salida de 256 bits, diseñado para máxima seguridad criptográfica. MD5 es un algoritmo de 128 bits más antiguo, rápido para comprobaciones de integridad pero no seguro ante colisiones deliberadas.',
  },
  {
    question: '¿Qué es HMAC y para qué sirve?',
    answer: 'HMAC (Código de Autenticación de Mensajes basado en Hash) incorpora una clave secreta al cálculo del hash, garantizando tanto la integridad del contenido como la autenticidad del emisor.',
  },
]);

const howToSchema = makeHowToSchema(
  'Cómo calcular y verificar hashes y checksums en línea',
  'Guía paso a paso para generar y comparar hashes SHA-256, SHA-512, SHA-384, SHA-1 y MD5 con privacidad 100% en el navegador.',
  steps
);

const localizedSeo = {
  title: 'Calculadora de Hash y Checksum – SHA-256, SHA-512, MD5',
  description:
    'Calcula hashes criptográficos (SHA-256, SHA-512, SHA-1, MD5) para textos y archivos en el navegador. Privacidad 100% del lado del cliente sin subidas.',
  keywords:
    'calculadora hash, checksum online, generador sha256, sha512 online, calcular md5, hmac online, suma comprobacion archivos, ni18',
  author: 'ni18',
  ogTitle: 'Calculadora de Hash y Checksum – SHA-256, SHA-512, MD5',
  ogDescription:
    'Calcula hashes criptográficos (SHA-256, SHA-512, SHA-1, MD5) para textos y archivos en el navegador. Privacidad 100% del lado del cliente sin subidas.',
  twitterDomain: 'online-tools.ni18.in',
  appSchema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Calculadora de Hash y Checksum',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    url: `${SITE_URL}/es/tools/calculadora-hash/`,
    description:
      'Genera y compara hashes criptográficos (SHA-256, SHA-512, SHA-384, SHA-1, MD5) y firmas HMAC con privacidad 100% local en tu navegador.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  extraJsonLd: [howToSchema, faqSchema],
};

const seo = toolSeo(tool, localizedSeo);
seo.canonical = `${SITE_URL}/es/tools/calculadora-hash/`;
seo.og.url = seo.canonical;
if (seo.twitter) seo.twitter.url = seo.canonical;

const altLinks = {
  en: `${SITE_URL}/tools/hash-calculator/`,
  es: `${SITE_URL}/es/tools/calculadora-hash/`,
  fr: `${SITE_URL}/fr/tools/calculateur-hash/`,
};
---

<ToolLayout seo={seo} lang="es" altLinks={altLinks}>
  <div class="tool-island" id="tool-hash-calculator">
    <header class="tool-header">
      <h1>Calculadora de Hash y Checksum</h1>
      <p class="subtitle">Calcula hashes SHA-256, SHA-512, SHA-1, MD5 y HMAC al instante en tu navegador con privacidad 100% local</p>
    </header>

    <!-- Quick Action Bar -->
    <div class="quick-actions">
      <button type="button" class="action-btn" id="btn-sample">
        <span>Cargar ejemplo</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-clear">
        <span>Limpiar</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-toggle-format">
        <span id="format-label">Formato: Hex Minúsculas</span>
      </button>
    </div>

    <!-- Main Workspace -->
    <div class="workspace-grid">
      <!-- Input Section -->
      <section class="pane input-pane" aria-labelledby="input-heading">
        <div class="pane-header">
          <h2 id="input-heading">Datos de Entrada</h2>
          <div class="tab-group" role="tablist" aria-label="Modo de Entrada">
            <button type="button" class="tab-btn active" id="tab-text" role="tab" aria-selected="true">Texto</button>
            <button type="button" class="tab-btn" id="tab-file" role="tab" aria-selected="false">Archivo</button>
          </div>
        </div>

        <!-- Text Input Mode -->
        <div id="text-input-wrap" class="input-wrap">
          <label for="hash-input-text" class="sr-only">Texto de entrada</label>
          <textarea
            id="hash-input-text"
            class="form-textarea code-font"
            rows="7"
            spellcheck="false"
            placeholder="Escribe o pega texto aquí para calcular hashes en tiempo real..."
          ></textarea>
        </div>

        <!-- File Input Mode -->
        <div id="file-input-wrap" class="input-wrap file-dropzone" style="display:none;">
          <input type="file" id="hash-input-file" class="file-input-hidden" />
          <div class="dropzone-inner" id="dropzone-area">
            <svg class="dropzone-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <p class="dropzone-text"><strong>Haz clic para seleccionar archivo</strong> o arrástralo aquí</p>
            <p class="dropzone-sub">El procesamiento ocurre 100% en la memoria de tu equipo</p>
            <div id="file-info" class="file-info" style="display:none;">
              <span id="file-name" class="file-info-name"></span>
              <span id="file-size" class="file-info-size"></span>
            </div>
          </div>
        </div>

        <!-- HMAC Settings -->
        <div class="hmac-box">
          <div class="hmac-header">
            <label class="switch-label">
              <input type="checkbox" id="enable-hmac" />
              <span>Activar HMAC (Hash con clave)</span>
            </label>
          </div>
          <div id="hmac-key-wrap" class="control-group" style="display:none; margin-top: 10px;">
            <label for="hmac-key">Clave Secreta:</label>
            <input type="text" id="hmac-key" class="form-input code-font" placeholder="Ingresa la clave secreta..." spellcheck="false" />
          </div>
        </div>

        <!-- Checksum Verification Box -->
        <div class="verify-box">
          <label for="verify-hash-input">Comparar con Hash / Checksum esperado:</label>
          <input
            type="text"
            id="verify-hash-input"
            class="form-input code-font"
            placeholder="Pega el hash esperado para comprobar coincidencia..."
            spellcheck="false"
          />
          <div id="verify-status" class="verify-status" style="display:none;">
            <span id="verify-badge" class="verify-badge"></span>
            <span id="verify-text" class="verify-text"></span>
          </div>
        </div>

        <div id="status-error" class="error-banner" style="display:none;" role="alert">
          <span id="error-message">Entrada no válida.</span>
        </div>
      </section>

      <!-- Output Section -->
      <section class="pane output-pane" aria-labelledby="output-heading">
        <div class="pane-header">
          <h2 id="output-heading">Hashes Criptográficos</h2>
          <div class="action-btn-group">
            <button type="button" class="copy-btn" id="btn-copy-all">
              <span>Copiar todos</span>
            </button>
          </div>
        </div>

        <div class="hash-list">
          <!-- SHA-256 -->
          <div class="hash-item" data-algo="SHA-256">
            <div class="hash-item-header">
              <span class="hash-algo-tag">SHA-256</span>
              <button type="button" class="hash-copy-btn" data-target="hash-sha256" title="Copiar SHA-256">Copiar</button>
            </div>
            <div id="hash-sha256" class="hash-value code-font" tabindex="0">e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855</div>
          </div>

          <!-- SHA-512 -->
          <div class="hash-item" data-algo="SHA-512">
            <div class="hash-item-header">
              <span class="hash-algo-tag">SHA-512</span>
              <button type="button" class="hash-copy-btn" data-target="hash-sha512" title="Copiar SHA-512">Copiar</button>
            </div>
            <div id="hash-sha512" class="hash-value code-font" tabindex="0">cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e</div>
          </div>

          <!-- SHA-384 -->
          <div class="hash-item" data-algo="SHA-384">
            <div class="hash-item-header">
              <span class="hash-algo-tag">SHA-384</span>
              <button type="button" class="hash-copy-btn" data-target="hash-sha384" title="Copiar SHA-384">Copiar</button>
            </div>
            <div id="hash-sha384" class="hash-value code-font" tabindex="0">38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b</div>
          </div>

          <!-- SHA-1 -->
          <div class="hash-item" data-algo="SHA-1">
            <div class="hash-item-header">
              <span class="hash-algo-tag">SHA-1</span>
              <button type="button" class="hash-copy-btn" data-target="hash-sha1" title="Copiar SHA-1">Copiar</button>
            </div>
            <div id="hash-sha1" class="hash-value code-font" tabindex="0">da39a3ee5e6b4b0d3255bfef95601890afd80709</div>
          </div>

          <!-- MD5 -->
          <div class="hash-item" data-algo="MD5">
            <div class="hash-item-header">
              <span class="hash-algo-tag">MD5</span>
              <button type="button" class="hash-copy-btn" data-target="hash-md5" title="Copiar MD5">Copiar</button>
            </div>
            <div id="hash-md5" class="hash-value code-font" tabindex="0">d41d8cd98f00b204e9800998ecf8427e</div>
          </div>
        </div>
      </section>
    </div>

    <!-- Educational Guide & FAQs (SEO Content) -->
    <article class="guide-section">
      <h2>Cómo utilizar la Calculadora de Hash y Checksum</h2>
      <p>Las funciones de hash criptográfico transforman cualquier cantidad de datos de entrada en cadenas de longitud fija únicas. Son pilares fundamentales en seguridad informática, firmas digitales, verificación de descargas y autenticación. Esta herramienta genera sumas de comprobación criptográficas y firmas HMAC de forma 100% privada en tu navegador.</p>

      <div class="features-grid">
        <div class="feature-card">
          <h3>⚡ Privacidad 100% en el Navegador</h3>
          <p>Los algoritmos se ejecutan mediante Web Crypto API (<code>crypto.subtle</code>). Ningún dato ni archivo sale de tu equipo.</p>
        </div>
        <div class="feature-card">
          <h3>📁 Comprobación de Archivos</h3>
          <p>Arrastra archivos para calcular hashes al instante y verificar que tus descargas no hayan sido alteradas o dañadas.</p>
        </div>
        <div class="feature-card">
          <h3>🔑 Compatibilidad HMAC y Formatos</h3>
          <p>Calcula firmas HMAC autenticadas con clave y cambia con un clic entre formatos Hexadecimal minúscula, mayúscula y Base64.</p>
        </div>
      </div>

      <h2>Instrucciones Paso a Paso</h2>
      <ol class="steps-list">
        <li><strong>Paso 1: Elige Texto o Archivo:</strong> Selecciona la pestaña "Texto" para frases o código, o "Archivo" para documentos, imágenes e instaladores.</li>
        <li><strong>Paso 2: Introduce los Datos:</strong> Escribe tu texto o arrastra tu archivo hacia la zona de soltado.</li>
        <li><strong>Paso 3: Configura Clave o Verificación:</strong> Opcionalmente activa HMAC para firmas con clave secreta o pega un checksum esperado para comprobar coincidencias.</li>
        <li><strong>Paso 4: Copia los Hashes:</strong> Haz clic en el botón copiar correspondiente al algoritmo requerido (SHA-256, SHA-512, SHA-384, SHA-1, MD5).</li>
      </ol>

      <h2>Análisis Técnico: Algoritmos y Resistencia a Colisiones</h2>
      <p>Una función hash criptográfica debe cumplir con propiedades clave: unidireccionalidad (imposible de revertir), resistencia a preimagen y resistencia a colisiones (dos entradas distintas no deben producir el mismo resultado).</p>

      <div class="table-wrap">
        <table class="algo-table">
          <thead>
            <tr>
              <th>Algoritmo</th>
              <th>Tamaño del Hash</th>
              <th>Uso Principal</th>
              <th>Estado Criptográfico</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>SHA-256</code></td>
              <td>256 bits (64 caracteres hex)</td>
              <td>TLS/SSL, Bitcoin, firmas de código, autenticación API</td>
              <td>Seguro (Estándar NIST)</td>
            </tr>
            <tr>
              <td><code>SHA-512</code></td>
              <td>512 bits (128 caracteres hex)</td>
              <td>Sistemas de alta seguridad, arquitecturas de 64 bits</td>
              <td>Seguro (Estándar NIST)</td>
            </tr>
            <tr>
              <td><code>SHA-384</code></td>
              <td>384 bits (96 caracteres hex)</td>
              <td>Criptografía NSA Suite B, certificados empresariales</td>
              <td>Seguro (Estándar NIST)</td>
            </tr>
            <tr>
              <td><code>SHA-1</code></td>
              <td>160 bits (40 caracteres hex)</td>
              <td>Commits heredados de Git, sumas simples</td>
              <td>Obsoleto para firmas de seguridad</td>
            </tr>
            <tr>
              <td><code>MD5</code></td>
              <td>128 bits (32 caracteres hex)</td>
              <td>Comprobación rápida de integridad no adversaria</td>
              <td>Inseguro para criptografía; útil para checksums rápidos</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Preguntas Frecuentes</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>¿Mis datos y archivos son privados y seguros?</summary>
          <p>Sí, 100%. Toda la ejecución se procesa en la memoria del navegador con la Web Crypto API nativa. Ningún dato se envía a servidores externos.</p>
        </details>
        <details class="faq-item">
          <summary>¿Puedo calcular el checksum de archivos grandes?</summary>
          <p>Sí. La herramienta procesa archivos mediante flujos ArrayBuffer sin cargarlos por la red, permitiendo un cálculo eficiente y seguro.</p>
        </details>
        <details class="faq-item">
          <summary>¿Cuál es la diferencia entre SHA-256 y MD5?</summary>
          <p>SHA-256 genera un hash de 256 bits altamente resistente a vulnerabilidades. MD5 produce 128 bits y posee vulnerabilidades conocidas de colisión.</p>
        </details>
        <details class="faq-item">
          <summary>¿Qué es HMAC y para qué sirve?</summary>
          <p>HMAC combina una clave secreta con la función hash para asegurar simultáneamente la integridad de los datos y autenticar al creador.</p>
        </details>
      </div>
    </article>
  </div>
</ToolLayout>

<style>
  #tool-hash-calculator { max-width: 1080px; margin: 0 auto; }
  .tool-header { text-align: center; margin-bottom: 24px; }
  .tool-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 700; margin: 0 0 8px; color: var(--md-sys-color-on-surface); }
  .subtitle { font-size: 1rem; color: var(--md-sys-color-on-surface-variant); margin: 0; }

  .quick-actions { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; justify-content: center; }
  .action-btn, .copy-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px;
    border-radius: var(--md-sys-shape-corner-small, 8px); font-size: 0.875rem; font-weight: 500;
    cursor: pointer; border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface);
    transition: background 0.15s, border-color 0.15s;
  }
  .action-btn:hover, .copy-btn:hover { background: var(--md-sys-color-surface-container-highest); border-color: var(--md-sys-color-primary); }
  .action-btn--secondary { background: var(--md-sys-color-surface-container-low); }

  .action-btn-group { display: flex; gap: 6px; }

  .workspace-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 36px; }
  .pane { background: var(--md-sys-color-surface-container-lowest); border: 1px solid var(--md-sys-color-outline-variant); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; }
  .pane-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
  .pane-header h2 { font-size: 1.1rem; font-weight: 600; margin: 0; color: var(--md-sys-color-on-surface); }

  .tab-group { display: inline-flex; border: 1px solid var(--md-sys-color-outline-variant); border-radius: 8px; overflow: hidden; }
  .tab-btn {
    padding: 6px 14px; border: none; background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface-variant); font-size: 0.85rem; font-weight: 500; cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .tab-btn.active {
    background: var(--md-sys-color-primary); color: var(--md-sys-color-on-primary); font-weight: 600;
  }

  .input-wrap { margin-bottom: 16px; }
  .form-textarea, .form-input {
    width: 100%; padding: 10px 12px; border-radius: 8px;
    border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface);
    font-size: 0.9rem; box-sizing: border-box;
  }
  .form-textarea { resize: vertical; line-height: 1.5; }
  .code-font { font-family: monospace; font-size: 0.875rem; word-break: break-all; }

  .file-dropzone {
    border: 2px dashed var(--md-sys-color-outline-variant); border-radius: 8px; padding: 24px 16px;
    text-align: center; cursor: pointer; transition: border-color 0.2s, background-color 0.2s;
    background: var(--md-sys-color-surface-container-low);
  }
  .file-dropzone.dragover { border-color: var(--md-sys-color-primary); background: var(--md-sys-color-surface-container-high); }
  .file-input-hidden { display: none; }
  .dropzone-icon { stroke: var(--md-sys-color-primary); margin-bottom: 8px; }
  .dropzone-text { margin: 0 0 4px; font-size: 0.95rem; color: var(--md-sys-color-on-surface); }
  .dropzone-sub { margin: 0; font-size: 0.8rem; color: var(--md-sys-color-on-surface-variant); }
  .file-info { margin-top: 12px; padding: 8px 12px; border-radius: 6px; background: var(--md-sys-color-surface-container-highest); display: inline-flex; gap: 12px; font-size: 0.85rem; }
  .file-info-name { font-weight: 600; color: var(--md-sys-color-on-surface); }
  .file-info-size { color: var(--md-sys-color-on-surface-variant); }

  .hmac-box, .verify-box {
    margin-top: 14px; padding: 12px 14px; border-radius: 8px;
    border: 1px solid var(--md-sys-color-outline-variant); background: var(--md-sys-color-surface-container-low);
  }
  .switch-label { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.875rem; font-weight: 500; color: var(--md-sys-color-on-surface); user-select: none; }
  .control-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px; color: var(--md-sys-color-on-surface-variant); }
  .verify-box label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: var(--md-sys-color-on-surface-variant); }

  .verify-status { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .verify-badge { padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .verify-badge.match { background: #1b5e20; color: #e8f5e9; }
  .verify-badge.mismatch { background: #b71c1c; color: #ffebee; }
  .verify-text { font-size: 0.85rem; font-weight: 500; }
  .verify-text.match { color: #2e7d32; }
  .verify-text.mismatch { color: #c62828; }

  .hash-list { display: flex; flex-direction: column; gap: 12px; }
  .hash-item {
    border: 1px solid var(--md-sys-color-outline-variant); border-radius: 8px;
    background: var(--md-sys-color-surface-container-low); padding: 10px 14px;
  }
  .hash-item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .hash-algo-tag { font-size: 0.8rem; font-weight: 700; color: var(--md-sys-color-primary); }
  .hash-copy-btn {
    padding: 3px 8px; font-size: 0.75rem; border-radius: 4px; border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); cursor: pointer;
  }
  .hash-copy-btn:hover { background: var(--md-sys-color-surface-container-highest); border-color: var(--md-sys-color-primary); }
  .hash-value {
    padding: 6px 8px; border-radius: 6px; background: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface); user-select: all; line-height: 1.4;
  }

  .error-banner { margin-top: 12px; padding: 10px 14px; border-radius: 8px; background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); font-size: 0.85rem; }

  .guide-section { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--md-sys-color-outline-variant); }
  .guide-section h2 { font-size: 1.5rem; font-weight: 700; margin: 28px 0 12px; color: var(--md-sys-color-on-surface); }
  .guide-section p { font-size: 0.95rem; line-height: 1.6; color: var(--md-sys-color-on-surface-variant); margin-bottom: 16px; }

  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin: 24px 0; }
  .feature-card { padding: 16px; background: var(--md-sys-color-surface-container-low); border: 1px solid var(--md-sys-color-outline-variant); border-radius: 8px; }
  .feature-card h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; color: var(--md-sys-color-primary); }
  .feature-card p { font-size: 0.875rem; margin: 0; line-height: 1.5; color: var(--md-sys-color-on-surface-variant); }

  .steps-list { margin: 16px 0 24px; padding-left: 20px; line-height: 1.8; color: var(--md-sys-color-on-surface-variant); }

  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .algo-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left; }
  .algo-table th, .algo-table td { padding: 10px 14px; border: 1px solid var(--md-sys-color-outline-variant); }
  .algo-table th { background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface); font-weight: 600; }
  .algo-table td { background: var(--md-sys-color-surface-container-lowest); color: var(--md-sys-color-on-surface-variant); }

  .faq-list { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
  .faq-item { background: var(--md-sys-color-surface-container-low); border: 1px solid var(--md-sys-color-outline-variant); border-radius: 8px; padding: 12px 16px; }
  .faq-item summary { font-weight: 600; cursor: pointer; color: var(--md-sys-color-on-surface); }
  .faq-item p { margin: 8px 0 0; font-size: 0.9rem; line-height: 1.5; color: var(--md-sys-color-on-surface-variant); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }
</style>

<script is:inline>
  (function () {
    // Pure JavaScript MD5 Implementation (RFC 1321)
    function md5(bytes) {
      function safeAdd(x, y) {
        const lsw = (x & 0xffff) + (y & 0xffff);
        const msw = (x >> 16) + (y >> 16) + (lsw >> 16);
        return (msw << 16) | (lsw & 0xffff);
      }
      function bitRol(num, cnt) {
        return (num << cnt) | (num >>> (32 - cnt));
      }
      function md5cmn(q, a, b, x, s, t) {
        return safeAdd(bitRol(safeAdd(safeAdd(a, q), safeAdd(x, t)), s), b);
      }
      function md5ff(a, b, c, d, x, s, t) {
        return md5cmn((b & c) | (~b & d), a, b, x, s, t);
      }
      function md5gg(a, b, c, d, x, s, t) {
        return md5cmn((b & d) | (c & ~d), a, b, x, s, t);
      }
      function md5hh(a, b, c, d, x, s, t) {
        return md5cmn(b ^ c ^ d, a, b, x, s, t);
      }
      function md5ii(a, b, c, d, x, s, t) {
        return md5cmn(c ^ (b | ~d), a, b, x, s, t);
      }

      const len = bytes.length;
      const nwords = ((len + 8) >> 6) + 1;
      const words = new Array(nwords * 16).fill(0);
      for (let i = 0; i < len; i++) {
        words[i >> 2] |= (bytes[i] & 0xff) << ((i % 4) * 8);
      }
      words[len >> 2] |= 0x80 << ((len % 4) * 8);
      words[nwords * 16 - 2] = len * 8;

      let a = 1732584193;
      let b = -271733879;
      let c = -1732584194;
      let d = 271733878;

      for (let i = 0; i < words.length; i += 16) {
        const olda = a;
        const oldb = b;
        const oldc = c;
        const oldd = d;

        a = md5ff(a, b, c, d, words[i + 0], 7, -680876936);
        d = md5ff(d, a, b, c, words[i + 1], 12, -389564586);
        c = md5ff(c, d, a, b, words[i + 2], 17, 606105819);
        b = md5ff(b, c, d, a, words[i + 3], 22, -1044525330);
        a = md5ff(a, b, c, d, words[i + 4], 7, -176418897);
        d = md5ff(d, a, b, c, words[i + 5], 12, 1200080426);
        c = md5ff(c, d, a, b, words[i + 6], 17, -1473231341);
        b = md5ff(b, c, d, a, words[i + 7], 22, -45705983);
        a = md5ff(a, b, c, d, words[i + 8], 7, 1770035416);
        d = md5ff(d, a, b, c, words[i + 9], 12, -1958414417);
        c = md5ff(c, d, a, b, words[i + 10], 17, -42063);
        b = md5ff(b, c, d, a, words[i + 11], 22, -1990404162);
        a = md5ff(a, b, c, d, words[i + 12], 7, 1804603682);
        d = md5ff(d, a, b, c, words[i + 13], 12, -40341101);
        c = md5ff(c, d, a, b, words[i + 14], 17, -1502002290);
        b = md5ff(b, c, d, a, words[i + 15], 22, 1236535329);

        a = md5gg(a, b, c, d, words[i + 1], 5, -165796510);
        d = md5gg(d, a, b, c, words[i + 6], 9, -1069501632);
        c = md5gg(c, d, a, b, words[i + 11], 14, 643717713);
        b = md5gg(b, c, d, a, words[i + 0], 20, -373897302);
        a = md5gg(a, b, c, d, words[i + 5], 5, -701558691);
        d = md5gg(d, a, b, c, words[i + 10], 9, 38016083);
        c = md5gg(c, d, a, b, words[i + 15], 14, -660478335);
        b = md5gg(b, c, d, a, words[i + 4], 20, -405537848);
        a = md5gg(a, b, c, d, words[i + 9], 5, 568446438);
        d = md5gg(d, a, b, c, words[i + 14], 9, -1019803690);
        c = md5gg(c, d, a, b, words[i + 3], 14, -187363961);
        b = md5gg(b, c, d, a, words[i + 8], 20, 1163531501);
        a = md5gg(a, b, c, d, words[i + 13], 5, -1444681467);
        d = md5gg(d, a, b, c, words[i + 2], 9, -51403784);
        c = md5gg(c, d, a, b, words[i + 7], 14, 1735328473);
        b = md5gg(b, c, d, a, words[i + 12], 20, -1926607734);

        a = md5hh(a, b, c, d, words[i + 5], 4, -378558);
        d = md5hh(d, a, b, c, words[i + 8], 11, -2022574463);
        c = md5hh(c, d, a, b, words[i + 11], 16, 1839030562);
        b = md5hh(b, c, d, a, words[i + 14], 23, -35309556);
        a = md5hh(a, b, c, d, words[i + 1], 4, -1530992060);
        d = md5hh(d, a, b, c, words[i + 4], 11, 1272893353);
        c = md5hh(c, d, a, b, words[i + 7], 16, -155497632);
        b = md5hh(b, c, d, a, words[i + 10], 23, -1094730640);
        a = md5hh(a, b, c, d, words[i + 13], 4, 681279174);
        d = md5hh(d, a, b, c, words[i + 0], 11, -358537222);
        c = md5hh(c, d, a, b, words[i + 3], 16, -722521979);
        b = md5hh(b, c, d, a, words[i + 6], 23, 76029189);
        a = md5hh(a, b, c, d, words[i + 9], 4, -640364487);
        d = md5hh(d, a, b, c, words[i + 12], 11, -421815835);
        c = md5hh(c, d, a, b, words[i + 15], 16, 530742520);
        b = md5hh(b, c, d, a, words[i + 2], 23, -995338651);

        a = md5ii(a, b, c, d, words[i + 0], 6, -198630844);
        d = md5ii(d, a, b, c, words[i + 7], 10, 1126891415);
        c = md5ii(c, d, a, b, words[i + 14], 15, -1416354905);
        b = md5ii(b, c, d, a, words[i + 5], 21, -57434055);
        a = md5ii(a, b, c, d, words[i + 12], 6, 1700485571);
        d = md5ii(d, a, b, c, words[i + 3], 10, -1894986606);
        c = md5ii(c, d, a, b, words[i + 10], 15, -1051523);
        b = md5ii(b, c, d, a, words[i + 1], 21, -2054922799);
        a = md5ii(a, b, c, d, words[i + 8], 6, 1873313359);
        d = md5ii(d, a, b, c, words[i + 15], 10, -30611744);
        c = md5ii(c, d, a, b, words[i + 6], 15, -1560198380);
        b = md5ii(b, c, d, a, words[i + 13], 21, 1309151649);
        a = md5ii(a, b, c, d, words[i + 4], 6, -145523070);
        d = md5ii(d, a, b, c, words[i + 11], 10, -1120210379);
        c = md5ii(c, d, a, b, words[i + 2], 15, 718787259);
        b = md5ii(b, c, d, a, words[i + 9], 21, -343485551);

        a = safeAdd(a, olda);
        b = safeAdd(b, oldb);
        c = safeAdd(c, oldc);
        d = safeAdd(d, oldd);
      }

      const out = new Uint8Array(16);
      const outWords = [a, b, c, d];
      for (let i = 0; i < 16; i++) {
        out[i] = (outWords[i >> 2] >> ((i % 4) * 8)) & 0xff;
      }
      return out;
    }

    // HMAC MD5 in pure JS
    function hmacMd5(keyBytes, msgBytes) {
      let k = new Uint8Array(keyBytes);
      if (k.length > 64) {
        k = md5(k);
      }
      const kPadded = new Uint8Array(64);
      kPadded.set(k);

      const oKeyPad = new Uint8Array(64);
      const iKeyPad = new Uint8Array(64);
      for (let i = 0; i < 64; i++) {
        oKeyPad[i] = kPadded[i] ^ 0x5c;
        iKeyPad[i] = kPadded[i] ^ 0x36;
      }

      const inner = new Uint8Array(64 + msgBytes.length);
      inner.set(iKeyPad);
      inner.set(msgBytes, 64);
      const innerHash = md5(inner);

      const outer = new Uint8Array(64 + 16);
      outer.set(oKeyPad);
      outer.set(innerHash, 64);
      return md5(outer);
    }

    // UI Elements
    const tabText = document.getElementById('tab-text');
    const tabFile = document.getElementById('tab-file');
    const textInputWrap = document.getElementById('text-input-wrap');
    const fileInputWrap = document.getElementById('file-input-wrap');
    const textInput = document.getElementById('hash-input-text');
    const fileInput = document.getElementById('hash-input-file');
    const dropzoneArea = document.getElementById('dropzone-area');
    const fileInfo = document.getElementById('file-info');
    const fileName = document.getElementById('file-name');
    const fileSize = document.getElementById('file-size');

    const enableHmac = document.getElementById('enable-hmac');
    const hmacKeyWrap = document.getElementById('hmac-key-wrap');
    const hmacKeyInput = document.getElementById('hmac-key');

    const verifyHashInput = document.getElementById('verify-hash-input');
    const verifyStatus = document.getElementById('verify-status');
    const verifyBadge = document.getElementById('verify-badge');
    const verifyText = document.getElementById('verify-text');

    const btnSample = document.getElementById('btn-sample');
    const btnClear = document.getElementById('btn-clear');
    const btnToggleFormat = document.getElementById('btn-toggle-format');
    const formatLabel = document.getElementById('format-label');
    const btnCopyAll = document.getElementById('btn-copy-all');

    const statusError = document.getElementById('status-error');
    const errorMessage = document.getElementById('error-message');

    const hashElements = {
      'SHA-256': document.getElementById('hash-sha256'),
      'SHA-512': document.getElementById('hash-sha512'),
      'SHA-384': document.getElementById('hash-sha384'),
      'SHA-1': document.getElementById('hash-sha1'),
      'MD5': document.getElementById('hash-md5'),
    };

    // States
    const FORMATS = ['hex-lower', 'hex-upper', 'base64'];
    const FORMAT_LABELS = {
      'hex-lower': 'Formato: Hex Minúsculas',
      'hex-upper': 'Formato: Hex Mayúsculas',
      'base64': 'Formato: Base64',
    };
    let currentFormatIdx = 0;
    let activeMode = 'text'; // 'text' | 'file'
    let currentFileBytes = null;
    let rawByteDigests = {};

    const STORAGE_KEY = 'onlineTools_hashCalculatorInput';

    function bufToHex(buffer, uppercase = false) {
      const bytes = new Uint8Array(buffer);
      let hex = '';
      for (let i = 0; i < bytes.length; i++) {
        hex += bytes[i].toString(16).padStart(2, '0');
      }
      return uppercase ? hex.toUpperCase() : hex;
    }

    function bufToBase64(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      for (let i = 0; i < bytes.byteLength; i++) {
        binary += String.fromCharCode(bytes[i]);
      }
      return btoa(binary);
    }

    function formatDigest(buffer) {
      const fmt = FORMATS[currentFormatIdx];
      if (fmt === 'hex-upper') return bufToHex(buffer, true);
      if (fmt === 'base64') return bufToBase64(buffer);
      return bufToHex(buffer, false);
    }

    async function computeSubtleHash(algo, dataBytes, isHmac, keyBytes) {
      if (isHmac) {
        const cryptoKey = await window.crypto.subtle.importKey(
          'raw',
          keyBytes,
          { name: 'HMAC', hash: { name: algo } },
          false,
          ['sign']
        );
        return await window.crypto.subtle.sign('HMAC', cryptoKey, dataBytes);
      } else {
        return await window.crypto.subtle.digest(algo, dataBytes);
      }
    }

    async function updateHashes() {
      try {
        statusError.style.display = 'none';

        let dataBytes;
        if (activeMode === 'text') {
          const enc = new TextEncoder();
          dataBytes = enc.encode(textInput.value || '');
        } else {
          dataBytes = currentFileBytes || new Uint8Array(0);
        }

        const isHmac = enableHmac.checked;
        const keyEnc = new TextEncoder();
        const keyBytes = keyEnc.encode(hmacKeyInput.value || '');

        // 1. SubtleCrypto algorithms
        const algos = ['SHA-256', 'SHA-512', 'SHA-384', 'SHA-1'];
        for (const algo of algos) {
          try {
            const buf = await computeSubtleHash(algo, dataBytes, isHmac, keyBytes);
            rawByteDigests[algo] = buf;
            if (hashElements[algo]) {
              hashElements[algo].textContent = formatDigest(buf);
            }
          } catch (e) {
            if (hashElements[algo]) hashElements[algo].textContent = 'Error calculando ' + algo;
          }
        }

        // 2. MD5 / HMAC-MD5
        try {
          let md5Buf;
          if (isHmac) {
            md5Buf = hmacMd5(keyBytes, dataBytes).buffer;
          } else {
            md5Buf = md5(dataBytes).buffer;
          }
          rawByteDigests['MD5'] = md5Buf;
          if (hashElements['MD5']) {
            hashElements['MD5'].textContent = formatDigest(md5Buf);
          }
        } catch (e) {
          if (hashElements['MD5']) hashElements['MD5'].textContent = 'Error calculando MD5';
        }

        runVerification();
        saveState();
      } catch (err) {
        statusError.style.display = 'block';
        errorMessage.textContent = 'Error en el cálculo: ' + err.message;
      }
    }

    function runVerification() {
      const query = (verifyHashInput.value || '').trim();
      if (!query) {
        verifyStatus.style.display = 'none';
        return;
      }

      verifyStatus.style.display = 'flex';
      const cleanQuery = query.toLowerCase();

      let matchedAlgo = null;
      for (const [algo, buf] of Object.entries(rawByteDigests)) {
        if (!buf) continue;
        const lowerHex = bufToHex(buf, false).toLowerCase();
        const b64 = bufToBase64(buf);
        if (cleanQuery === lowerHex || query === b64) {
          matchedAlgo = algo;
          break;
        }
      }

      if (matchedAlgo) {
        verifyBadge.className = 'verify-badge match';
        verifyBadge.textContent = 'COINCIDENCIA';
        verifyText.className = 'verify-text match';
        verifyText.textContent = `¡Coincidencia válida para ${matchedAlgo}! Checksum verificado.`;
      } else {
        verifyBadge.className = 'verify-badge mismatch';
        verifyBadge.textContent = 'SIN COINCIDENCIA';
        verifyText.className = 'verify-text mismatch';
        verifyText.textContent = 'El hash esperado no coincide con ninguno de los generados.';
      }
    }

    function saveState() {
      try {
        const payload = {
          mode: activeMode,
          text: textInput.value,
          hmac: enableHmac.checked,
          hmacKey: hmacKeyInput.value,
          verify: verifyHashInput.value,
          format: currentFormatIdx,
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (e) {}
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const payload = JSON.parse(raw);
          if (payload.text !== undefined) textInput.value = payload.text;
          if (payload.hmac !== undefined) {
            enableHmac.checked = !!payload.hmac;
            hmacKeyWrap.style.display = payload.hmac ? 'block' : 'none';
          }
          if (payload.hmacKey !== undefined) hmacKeyInput.value = payload.hmacKey;
          if (payload.verify !== undefined) verifyHashInput.value = payload.verify;
          if (payload.format !== undefined) {
            currentFormatIdx = payload.format % FORMATS.length;
            formatLabel.textContent = FORMAT_LABELS[FORMATS[currentFormatIdx]];
          }
          updateHashes();
        } else {
          btnSample.click();
        }
      } catch (e) {
        btnSample.click();
      }
    }

    // Event Listeners
    tabText.addEventListener('click', () => {
      activeMode = 'text';
      tabText.classList.add('active');
      tabText.setAttribute('aria-selected', 'true');
      tabFile.classList.remove('active');
      tabFile.setAttribute('aria-selected', 'false');
      textInputWrap.style.display = 'block';
      fileInputWrap.style.display = 'none';
      updateHashes();
    });

    tabFile.addEventListener('click', () => {
      activeMode = 'file';
      tabFile.classList.add('active');
      tabFile.setAttribute('aria-selected', 'true');
      tabText.classList.remove('active');
      tabText.setAttribute('aria-selected', 'false');
      textInputWrap.style.display = 'none';
      fileInputWrap.style.display = 'block';
      updateHashes();
    });

    textInput.addEventListener('input', updateHashes);

    enableHmac.addEventListener('change', () => {
      hmacKeyWrap.style.display = enableHmac.checked ? 'block' : 'none';
      updateHashes();
    });

    hmacKeyInput.addEventListener('input', updateHashes);
    verifyHashInput.addEventListener('input', runVerification);

    btnToggleFormat.addEventListener('click', () => {
      currentFormatIdx = (currentFormatIdx + 1) % FORMATS.length;
      formatLabel.textContent = FORMAT_LABELS[FORMATS[currentFormatIdx]];
      for (const [algo, buf] of Object.entries(rawByteDigests)) {
        if (buf && hashElements[algo]) {
          hashElements[algo].textContent = formatDigest(buf);
        }
      }
      saveState();
      if (window.showToast) window.showToast(`Formato cambiado a ${FORMATS[currentFormatIdx]}`);
    });

    btnSample.addEventListener('click', () => {
      activeMode = 'text';
      tabText.click();
      textInput.value = 'The quick brown fox jumps over the lazy dog';
      enableHmac.checked = false;
      hmacKeyWrap.style.display = 'none';
      hmacKeyInput.value = '';
      verifyHashInput.value = 'd7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592';
      updateHashes();
    });

    btnClear.addEventListener('click', () => {
      textInput.value = '';
      currentFileBytes = null;
      fileInfo.style.display = 'none';
      fileInput.value = '';
      hmacKeyInput.value = '';
      verifyHashInput.value = '';
      updateHashes();
      if (window.showToast) window.showToast('Entrada limpiada');
    });

    // File Drag and Drop
    dropzoneArea.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        handleFile(e.target.files[0]);
      }
    });

    dropzoneArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzoneArea.classList.add('dragover');
    });
    dropzoneArea.addEventListener('dragleave', () => dropzoneArea.classList.remove('dragover'));
    dropzoneArea.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzoneArea.classList.remove('dragover');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFile(e.dataTransfer.files[0]);
      }
    });

    function formatBytes(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function handleFile(file) {
      fileName.textContent = file.name;
      fileSize.textContent = `(${formatBytes(file.size)})`;
      fileInfo.style.display = 'inline-flex';

      const reader = new FileReader();
      reader.onload = function (evt) {
        currentFileBytes = new Uint8Array(evt.target.result);
        updateHashes();
        if (window.showToast) window.showToast(`Cargado ${file.name}`);
      };
      reader.onerror = function () {
        statusError.style.display = 'block';
        errorMessage.textContent = 'Error al leer el archivo.';
      };
      reader.readAsArrayBuffer(file);
    }

    // Copy actions
    document.querySelectorAll('.hash-copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const el = document.getElementById(targetId);
        if (el && el.textContent) {
          navigator.clipboard.writeText(el.textContent).then(() => {
            if (window.showToast) window.showToast('¡Hash copiado al portapapeles!');
          });
        }
      });
    });

    btnCopyAll.addEventListener('click', () => {
      const lines = [];
      for (const algo of ['SHA-256', 'SHA-512', 'SHA-384', 'SHA-1', 'MD5']) {
        if (hashElements[algo]) {
          lines.push(`${algo}: ${hashElements[algo].textContent}`);
        }
      }
      if (lines.length > 0) {
        navigator.clipboard.writeText(lines.join('\n')).then(() => {
          if (window.showToast) window.showToast('¡Todos los hashes copiados!');
        });
      }
    });

    loadState();
  })();
</script>
