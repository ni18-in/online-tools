---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import { getTool, toolSeo, makeFaqSchema, makeHowToSchema } from '../../../../data/tools';
import { SITE_URL } from '../../../../data/site';

const tool = getTool('cron-expression-builder')!;

const steps = [
  {
    title: 'Selecciona parámetros o elige un ajuste predeterminado',
    description: 'Utiliza los controles visuales interactivos para configurar minutos, horas, día del mes, mes y día de la semana, o elige ajustes preestablecidos como ejecuciones horarias o diarias a medianoche.',
  },
  {
    title: 'Inspecciona la explicación en lenguaje natural',
    description: 'Observa cómo el explicador cron traduce automáticamente la sintaxis de 5 campos en oraciones claras y comprensibles en español.',
  },
  {
    title: 'Verifica las próximas ejecuciones',
    description: 'Revisa las próximas 5 marcas de tiempo calculadas (en hora local y UTC) para confirmar la programación exacta antes de desplegar.',
  },
  {
    title: 'Copia la expresión cron al portapapeles',
    description: 'Haz clic en el botón de copiar para guardar la expresión de 5 campos lista para crontab, GitHub Actions, AWS EventBridge o Kubernetes.',
  },
];

const faqSchema = makeFaqSchema([
  {
    question: '¿Mi configuración de programación es privada y segura?',
    answer: 'Sí, 100%. Todo el análisis de expresiones, la explicación en lenguaje natural y los cálculos de marcas de tiempo se ejecutan completamente en la memoria de tu navegador local. Ningún parámetro se envía a servidores remotos.',
  },
  {
    question: '¿Qué formato genera este creador de expresiones cron?',
    answer: 'Esta herramienta genera expresiones cron estándar de 5 campos UNIX / POSIX con el formato: Minuto (0-59), Hora (0-23), Día del mes (1-31), Mes (1-12) y Día de la semana (0-6).',
  },
  {
    question: '¿Cómo funcionan los valores de intervalo como */15 en cron?',
    answer: 'Un asterisco con una barra y un número de intervalo (por ejemplo, */15 en el campo de minutos) especifica una repetición periódica, es decir, "cada 15 unidades".',
  },
  {
    question: '¿Puedo probar expresiones cron personalizadas generadas fuera de la herramienta?',
    answer: 'Sí. Escribe o pega cualquier cadena cron estándar de 5 partes en la casilla de entrada. Los selectores visuales, la explicación traducida y las próximas ejecuciones se actualizarán al instante.',
  },
]);

const howToSchema = makeHowToSchema(
  'Cómo crear y explicar expresiones cron en línea',
  'Guía paso a paso para crear, analizar y verificar visualmente programaciones cron de 5 partes en UNIX con predicción de próximas ejecuciones.',
  steps
);

const localizedSeo = {
  title: 'Generador de Expresiones Cron – Creador y Explicador Visual',
  description:
    'Crea, analiza y explica expresiones cron de forma visual en tu navegador. Obtén próximas ejecuciones con privacidad 100% del lado del cliente.',
  keywords:
    'generador de expresiones cron, creador cron, explicador cron, crontab generador, calculador cron, proximas ejecuciones cron, ni18',
  author: 'ni18',
  ogTitle: 'Generador de Expresiones Cron – Creador y Explicador Visual',
  ogDescription:
    'Crea, analiza y explica expresiones cron de forma visual en tu navegador. Obtén próximas ejecuciones con privacidad 100% del lado del cliente.',
  twitterDomain: 'online-tools.ni18.in',
  appSchema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Generador de Expresiones Cron',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    url: `${SITE_URL}/es/tools/generador-expresiones-cron/`,
    description:
      'Crea, analiza y explica expresiones cron de forma visual en tu navegador con explicaciones en lenguaje natural y proyección de ejecuciones futuras.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  extraJsonLd: [howToSchema, faqSchema],
};

const seo = toolSeo(tool, localizedSeo);
seo.canonical = `${SITE_URL}/es/tools/generador-expresiones-cron/`;
seo.og.url = seo.canonical;
if (seo.twitter) seo.twitter.url = seo.canonical;

const altLinks = {
  en: `${SITE_URL}/tools/cron-expression-builder/`,
  es: `${SITE_URL}/es/tools/generador-expresiones-cron/`,
  fr: `${SITE_URL}/fr/tools/generateur-expressions-cron/`,
};
---

<ToolLayout seo={seo} lang="es" altLinks={altLinks}>
  <div class="tool-island" id="tool-cron-expression-builder">
    <header class="tool-header">
      <h1>Generador de Expresiones Cron</h1>
      <p class="subtitle">Crea, analiza y convierte expresiones cron de 5 campos a lenguaje natural comprensible con predicción de próximas ejecuciones</p>
    </header>

    <!-- Quick Action Bar -->
    <div class="quick-actions">
      <button type="button" class="action-btn" id="btn-sample">
        <span>Cargar ejemplo</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-clear">
        <span>Limpiar</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-preset-hourly">
        <span>Cada hora</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-preset-daily">
        <span>Diario a medianoche</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-preset-workdays">
        <span>Días laborales a las 9 AM</span>
      </button>
    </div>

    <!-- Main Workspace -->
    <div class="workspace-grid">
      <!-- Input & Visual Selectors -->
      <section class="pane input-pane" aria-labelledby="builder-heading">
        <div class="pane-header">
          <h2 id="builder-heading">Expresión Cron y Controles Visuales</h2>
        </div>

        <div class="control-group">
          <label for="cron-input">Expresión Cron (5 campos: Min Hora DíaMes Mes DíaSemana)</label>
          <input type="text" id="cron-input" class="form-input code-font" value="0 0 * * *" spellcheck="false" placeholder="* * * * *" />
        </div>

        <div class="visual-controls">
          <div class="control-group">
            <label for="sel-minute">Minuto (0 - 59)</label>
            <select id="sel-minute" class="form-select">
              <option value="*">Cada minuto (*)</option>
              <option value="0" selected>En el minuto 0 (0)</option>
              <option value="*/5">Cada 5 minutos (*/5)</option>
              <option value="*/10">Cada 10 minutos (*/10)</option>
              <option value="*/15">Cada 15 minutos (*/15)</option>
              <option value="*/30">Cada 30 minutos (*/30)</option>
              <option value="0,30">En los minutos 0 y 30 (0,30)</option>
            </select>
          </div>

          <div class="control-group">
            <label for="sel-hour">Hora (0 - 23)</label>
            <select id="sel-hour" class="form-select">
              <option value="*">Cada hora (*)</option>
              <option value="0" selected>A las 00:00 / Medianoche (0)</option>
              <option value="*/2">Cada 2 horas (*/2)</option>
              <option value="*/6">Cada 6 horas (*/6)</option>
              <option value="*/12">Cada 12 horas (*/12)</option>
              <option value="9">A las 09:00 AM (9)</option>
              <option value="12">A las 12:00 PM / Mediodía (12)</option>
              <option value="18">A las 06:00 PM (18)</option>
            </select>
          </div>

          <div class="control-group">
            <label for="sel-dom">Día del Mes (1 - 31)</label>
            <select id="sel-dom" class="form-select">
              <option value="*" selected>Todos los días (*)</option>
              <option value="1">El primer día del mes (1)</option>
              <option value="15">El día 15 del mes (15)</option>
              <option value="1,15">Días 1 y 15 (1,15)</option>
              <option value="*/2">Cada 2 días (*/2)</option>
            </select>
          </div>

          <div class="control-group">
            <label for="sel-month">Mes (1 - 12)</label>
            <select id="sel-month" class="form-select">
              <option value="*" selected>Todos los meses (*)</option>
              <option value="1">Enero (1)</option>
              <option value="3">Marzo (3)</option>
              <option value="6">Junio (6)</option>
              <option value="9">Septiembre (9)</option>
              <option value="12">Diciembre (12)</option>
              <option value="1,4,7,10">Inicio de trimestres (1,4,7,10)</option>
            </select>
          </div>

          <div class="control-group">
            <label for="sel-dow">Día de la semana (0 - 6, 0=Dom)</label>
            <select id="sel-dow" class="form-select">
              <option value="*" selected>Todos los días de la semana (*)</option>
              <option value="1-5">De lunes a viernes (1-5)</option>
              <option value="0,6">Fines de semana (Domingo y Sábado - 0,6)</option>
              <option value="1">Cada lunes (1)</option>
              <option value="5">Cada viernes (5)</option>
            </select>
          </div>
        </div>

        <div id="status-error" class="error-banner" style="display:none;" role="alert">
          <span id="error-message">Sintaxis cron no válida. Se esperan 5 campos separados por espacios.</span>
        </div>
      </section>

      <!-- Output Summary & Next Execution Predictions -->
      <section class="pane output-pane" aria-labelledby="output-heading">
        <div class="pane-header">
          <h2 id="output-heading">Análisis de la Programación</h2>
          <button type="button" class="copy-btn" id="btn-copy"><span>Copiar Expresión</span></button>
        </div>

        <div class="explanation-box">
          <span class="explanation-label">Explicación en lenguaje natural:</span>
          <p id="explanation-text" class="explanation-val">A las 00:00 todos los días.</p>
        </div>

        <div class="pane-header sub-header">
          <h2>Próximas 5 Ejecuciones Programadas</h2>
        </div>
        <ul id="next-runs-list" class="next-runs-list">
          <li>Calculando calendario de ejecuciones...</li>
        </ul>
      </section>
    </div>

    <!-- Educational Guide & FAQs (SEO Content) -->
    <article class="guide-section">
      <h2>Cómo utilizar el Generador de Expresiones Cron</h2>
      <p>Las expresiones cron son el estándar utilizado en administración de sistemas Linux, desarrollo de software, pipelines CI/CD y arquitecturas serverless para programar tareas periódicas. Este editor visual te permite construir, validar y auditar sintaxis cron sin riesgo de errores de programación.</p>

      <div class="features-grid">
        <div class="feature-card">
          <h3>⚡ Privacidad 100% en el Navegador</h3>
          <p>Tus expresiones y configuraciones jamás se envían a servidores externos. Todo se procesa localmente en la memoria de tu dispositivo.</p>
        </div>
        <div class="feature-card">
          <h3>💬 Traducción en Lenguaje Claro</h3>
          <p>Traduce la sintaxis de 5 campos a oraciones claras en español para que todo tu equipo entienda la programación exacta.</p>
        </div>
        <div class="feature-card">
          <h3>⏱️ Pronóstico de Ejecuciones</h3>
          <p>Calcula y proyecta en tiempo real las próximas 5 fechas de ejecución para prevenir fallos en la automatización de procesos.</p>
        </div>
      </div>

      <h2>Instrucciones Paso a Paso</h2>
      <ol class="steps-list">
        <li><strong>Paso 1: Selecciona un ajuste predeterminado o usa los controles:</strong> Elige un ajuste rápido (como Días laborales a las 9 AM) o ajusta los desplegables de minutos, horas y días.</li>
        <li><strong>Paso 2: Inspecciona el resumen traducido:</strong> Lee la descripción en lenguaje natural para asegurar que la frecuencia coincide con lo previsto.</li>
        <li><strong>Paso 3: Verifica las próximas ejecuciones:</strong> Revisa el listado con las próximas 5 ejecuciones calculadas en tu zona horaria local.</li>
        <li><strong>Paso 4: Copia y despliega:</strong> Copia la cadena de 5 campos lista para incluir en tu archivo crontab, GitHub Actions o definición de Kubernetes.</li>
      </ol>

      <h2>Análisis Técnico: Sintaxis UNIX Cron</h2>
      <p>Las expresiones cron estándar en UNIX constan de 5 campos separados por espacios: <code>Minuto Hora Día-del-Mes Mes Día-de-la-Semana</code>.</p>

      <div class="table-wrap">
        <table class="cron-table">
          <thead>
            <tr>
              <th>Campo</th>
              <th>Valores Permitidos</th>
              <th>Caracteres Especiales</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1. Minuto</td>
              <td>0 – 59</td>
              <td><code>*</code> <code>,</code> <code>-</code> <code>/</code></td>
            </tr>
            <tr>
              <td>2. Hora</td>
              <td>0 – 23</td>
              <td><code>*</code> <code>,</code> <code>-</code> <code>/</code></td>
            </tr>
            <tr>
              <td>3. Día del mes</td>
              <td>1 – 31</td>
              <td><code>*</code> <code>,</code> <code>-</code> <code>/</code></td>
            </tr>
            <tr>
              <td>4. Mes</td>
              <td>1 – 12</td>
              <td><code>*</code> <code>,</code> <code>-</code> <code>/</code></td>
            </tr>
            <tr>
              <td>5. Día de la semana</td>
              <td>0 – 6 (0 = Domingo)</td>
              <td><code>*</code> <code>,</code> <code>-</code> <code>/</code></td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>Preguntas Frecuentes</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>¿Es segura y privada mi información?</summary>
          <p>Sí, 100%. Toda la lógica funciona localmente en tu navegador usando JavaScript nativo. Sin registro ni envíos de datos.</p>
        </details>
        <details class="faq-item">
          <summary>¿Qué formato de expresión cron genera esta herramienta?</summary>
          <p>Genera el estándar UNIX / POSIX de 5 campos: Minuto (0-59), Hora (0-23), Día del mes (1-31), Mes (1-12) y Día de la semana (0-6).</p>
        </details>
        <details class="faq-item">
          <summary>¿Cómo funcionan los intervalos como */15?</summary>
          <p>Un asterisco con barra y número (por ejemplo, */15 en minutos) indica repeticiones periódicas cada 15 unidades de tiempo.</p>
        </details>
        <details class="faq-item">
          <summary>¿Puedo probar expresiones cron personalizadas?</summary>
          <p>Sí. Introduce cualquier expresión cron válida de 5 campos en el cuadro de texto para analizar su significado y próximas ejecuciones.</p>
        </details>
      </div>
    </article>
  </div>
</ToolLayout>

<style>
  #tool-cron-expression-builder { max-width: 1080px; margin: 0 auto; }
  .tool-header { text-align: center; margin-bottom: 24px; }
  .tool-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 700; margin: 0 0 8px; color: var(--md-sys-color-on-surface); }
  .subtitle { font-size: 1rem; color: var(--md-sys-color-on-surface-variant); margin: 0; }

  .quick-actions { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; justify-content: center; }
  .action-btn, .copy-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
    border-radius: var(--md-sys-shape-corner-small, 8px); font-size: 0.875rem; font-weight: 500;
    cursor: pointer; border: 1px solid var(--md-sys-color-outline-variant);
