  .faq-item summary { font-weight: 600; cursor: pointer; color: var(--md-sys-color-on-surface); }
  .faq-item p { margin: 8px 0 0; font-size: 0.9rem; line-height: 1.5; color: var(--md-sys-color-on-surface-variant); }
</style>

<script is:inline>
  (function () {
    const cronInput = document.getElementById('cron-input');
    const selMin = document.getElementById('sel-minute');
    const selHour = document.getElementById('sel-hour');
    const selDom = document.getElementById('sel-dom');
    const selMonth = document.getElementById('sel-month');
    const selDow = document.getElementById('sel-dow');

    const btnSample = document.getElementById('btn-sample');
    const btnClear = document.getElementById('btn-clear');
    const btnHourly = document.getElementById('btn-preset-hourly');
    const btnDaily = document.getElementById('btn-preset-daily');
    const btnWorkdays = document.getElementById('btn-preset-workdays');
    const btnCopy = document.getElementById('btn-copy');

    const explanationText = document.getElementById('explanation-text');
    const nextRunsList = document.getElementById('next-runs-list');
    const statusError = document.getElementById('status-error');

    const STORAGE_KEY = 'onlineTools_cronExpressionBuilderInput';

    const MONTH_NAMES = ['', 'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const DAY_NAMES = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];

    function parseField(field, min, max) {
      if (field === '*') {
        const res = [];
        for (let i = min; i <= max; i++) res.push(i);
        return res;
      }
      const values = new Set();
      const parts = field.split(',');
      for (const part of parts) {
        if (part.includes('/')) {
          const [range, stepStr] = part.split('/');
          const step = parseInt(stepStr, 10);
          if (isNaN(step) || step <= 0) return null;
          let start = min;
          let end = max;
          if (range !== '*') {
            if (range.includes('-')) {
              const [s, e] = range.split('-').map((v) => parseInt(v, 10));
              if (isNaN(s) || isNaN(e)) return null;
              start = s; end = e;
            } else {
              start = parseInt(range, 10);
              if (isNaN(start)) return null;
            }
          }
          for (let i = start; i <= end; i += step) {
            if (i >= min && i <= max) values.add(i);
          }
        } else if (part.includes('-')) {
          const [s, e] = part.split('-').map((v) => parseInt(v, 10));
          if (isNaN(s) || isNaN(e) || s > e) return null;
          for (let i = s; i <= e; i++) {
            if (i >= min && i <= max) values.add(i);
          }
        } else {
          const val = parseInt(part, 10);
          if (isNaN(val) || val < min || val > max) return null;
          values.add(val);
        }
      }
      return Array.from(values).sort((a, b) => a - b);
    }

    function explainCron(m, h, dom, mon, dow) {
      let minuteDesc = m === '*' ? 'cada minuto' : m.startsWith('*/') ? `cada ${m.slice(2)} minutos` : `en el minuto ${m}`;
      let hourDesc = h === '*' ? 'cada hora' : h.startsWith('*/') ? `cada ${h.slice(2)} horas` : `a las ${h.padStart(2, '0')}:00`;
      let domDesc = dom === '*' ? '' : `el día ${dom} del mes`;
      let monDesc = mon === '*' ? '' : `en ${mon.split(',').map((v) => MONTH_NAMES[parseInt(v, 10)] || v).join(', ')}`;
      let dowDesc = dow === '*' ? '' : dow === '1-5' ? 'de lunes a viernes' : dow === '0,6' ? 'fines de semana' : `el ${dow.split(',').map((v) => DAY_NAMES[parseInt(v, 10)] || v).join(', ')}`;

      let summary = `Se ejecuta ${minuteDesc}`;
      if (h !== '*') summary += `, ${hourDesc}`;
      if (domDesc) summary += `, ${domDesc}`;
      if (dowDesc) summary += `, ${dowDesc}`;
      if (monDesc) summary += `, ${monDesc}`;

      return summary + '.';
    }

    function calculateNextRuns(mArr, hArr, domArr, monArr, dowArr) {
      const runs = [];
      let iter = new Date();
      iter.setSeconds(0, 0);
      iter.setMinutes(iter.getMinutes() + 1);

      let maxIterations = 525600;
      while (runs.length < 5 && maxIterations > 0) {
        maxIterations--;
        const currentMonth = iter.getMonth() + 1;
        if (!monArr.includes(currentMonth)) {
          iter.setMonth(iter.getMonth() + 1, 1);
          iter.setHours(0, 0, 0, 0);
          continue;
        }

        const currentDom = iter.getDate();
        const currentDow = iter.getDay();
        if (!domArr.includes(currentDom) || !dowArr.includes(currentDow)) {
          iter.setDate(iter.getDate() + 1);
          iter.setHours(0, 0, 0, 0);
          continue;
        }

        const currentHour = iter.getHours();
        if (!hArr.includes(currentHour)) {
          iter.setHours(iter.getHours() + 1, 0, 0, 0);
          continue;
        }

        const currentMin = iter.getMinutes();
        if (!mArr.includes(currentMin)) {
          iter.setMinutes(iter.getMinutes() + 1, 0, 0);
          continue;
        }

        runs.push(new Date(iter));
        iter.setMinutes(iter.getMinutes() + 1);
      }
      return runs;
    }

    function updateAll() {
      try {
        statusError.style.display = 'none';
        const expr = cronInput.value.trim().replace(/\s+/g, ' ');
        const fields = expr.split(' ');

        if (fields.length !== 5) {
          statusError.style.display = 'block';
          explanationText.textContent = 'Expresión inválida. Introduce 5 campos separados por espacios.';
          nextRunsList.innerHTML = '<li>No se puede calcular el calendario para una entrada inválida.</li>';
          return;
        }

        const [mStr, hStr, domStr, monStr, dowStr] = fields;
        const mArr = parseField(mStr, 0, 59);
        const hArr = parseField(hStr, 0, 23);
        const domArr = parseField(domStr, 1, 31);
        const monArr = parseField(monStr, 1, 12);
        const dowArr = parseField(dowStr, 0, 6);

        if (!mArr || !hArr || !domArr || !monArr || !dowArr || mArr.length === 0 || hArr.length === 0 || domArr.length === 0 || monArr.length === 0 || dowArr.length === 0) {
          statusError.style.display = 'block';
          explanationText.textContent = 'Sintaxis de campo cron no válida o valor fuera de rango.';
          nextRunsList.innerHTML = '<li>No se puede calcular el calendario para una entrada inválida.</li>';
          return;
        }

        explanationText.textContent = explainCron(mStr, hStr, domStr, monStr, dowStr);

        const nextRuns = calculateNextRuns(mArr, hArr, domArr, monArr, dowArr);
        if (nextRuns.length === 0) {
          nextRunsList.innerHTML = '<li>No se encontraron próximas ejecuciones en un plazo de 1 año.</li>';
        } else {
          nextRunsList.innerHTML = nextRuns
            .map((date) => `<li>📅 ${date.toLocaleString('es-ES')} (UTC: ${date.toISOString().replace('.000Z', 'Z')})</li>`)
            .join('');
        }

        saveState();
      } catch (e) {
        statusError.style.display = 'block';
      }
    }

    function syncDropdownsToInput() {
      cronInput.value = `${selMin.value} ${selHour.value} ${selDom.value} ${selMonth.value} ${selDow.value}`;
      updateAll();
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, cronInput.value);
      } catch (e) {}
    }

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          cronInput.value = saved;
        }
      } catch (e) {}
    }

    cronInput.addEventListener('input', updateAll);
    selMin.addEventListener('change', syncDropdownsToInput);
    selHour.addEventListener('change', syncDropdownsToInput);
    selDom.addEventListener('change', syncDropdownsToInput);
    selMonth.addEventListener('change', syncDropdownsToInput);
    selDow.addEventListener('change', syncDropdownsToInput);

    btnSample.addEventListener('click', () => {
      cronInput.value = '*/15 9-17 * * 1-5';
      updateAll();
    });

    btnClear.addEventListener('click', () => {
      cronInput.value = '* * * * *';
      selMin.value = '*';
      selHour.value = '*';
      selDom.value = '*';
      selMonth.value = '*';
      selDow.value = '*';
      updateAll();
    });

    btnHourly.addEventListener('click', () => {
      cronInput.value = '0 * * * *';
      selMin.value = '0';
      selHour.value = '*';
      selDom.value = '*';
      selMonth.value = '*';
      selDow.value = '*';
      updateAll();
    });

    btnDaily.addEventListener('click', () => {
      cronInput.value = '0 0 * * *';
      selMin.value = '0';
      selHour.value = '0';
      selDom.value = '*';
      selMonth.value = '*';
      selDow.value = '*';
      updateAll();
    });

    btnWorkdays.addEventListener('click', () => {
      cronInput.value = '0 9 * * 1-5';
      selMin.value = '0';
      selHour.value = '9';
      selDom.value = '*';
      selMonth.value = '*';
      selDow.value = '1-5';
      updateAll();
    });

    btnCopy.addEventListener('click', () => {
      if (!cronInput.value) return;
      navigator.clipboard.writeText(cronInput.value).then(() => {
        if (window.showToast) window.showToast('¡Expresión cron copiada!');
      });
    });

    loadState();
    updateAll();
  })();
</script>
