</style>

<script is:inline>
  // ==================== CLIENT LOGIC FOR JEE MOCK TEST ====================
  (function () {
    const APP_URL = 'https://play.google.com/store/apps/details?id=in.ni18.jeemocktest';
    const IMG_BASE_URL = 'https://ni18-in.github.io/backend-jee-mock-test/jee_mains_27_jan_2024_shift_1/';

    let paper = null;
    let manifest = null;

    try {
      const pRaw = document.getElementById('jee-paper-data');
      if (pRaw) paper = JSON.parse(pRaw.textContent);
      const mRaw = document.getElementById('jee-manifest-data');
      if (mRaw) manifest = JSON.parse(mRaw.textContent);
    } catch (e) {
      console.error('Failed to parse embedded exam data:', e);
    }

    // Flat questions catalog
    // [{ globalIndex, id, subjectId, subjectName, sectionName, question, marks, negativeMarks }]
    const allQuestions = [];
    const questionsBySubject = { physics: [], chem: [], math: [] };

    if (paper && paper.sections) {
      // Sort sections so Physics is first, then Chemistry, then Mathematics
      const sectionOrder = ['physics', 'chem', 'math'];
      const sortedSections = [...paper.sections].sort(
        (a, b) => sectionOrder.indexOf(a.id) - sectionOrder.indexOf(b.id)
      );
      sortedSections.forEach((s) => {
        const sId = s.id; // 'physics', 'chem', 'math'
        s.subsections.forEach((sub) => {
          sub.questions.forEach((q) => {
            const item = {
              globalIndex: allQuestions.length,
              subjectIndex: questionsBySubject[sId] ? questionsBySubject[sId].length : 0,
              subjectId: sId,
              subjectName: s.name,
              sectionName: sub.name,
              question: q,
              marks: q.marks || 4,
              negativeMarks: q.negativeMarks !== undefined ? q.negativeMarks : -1,
            };
            allQuestions.push(item);
            if (questionsBySubject[sId]) {
              questionsBySubject[sId].push(item);
            }
          });
        });
      });
    }

    // Candidate State:
    // answers[qId] = { selectedOptionId: '1'|'2'|..., numericalValue: '5', isAnswered: bool, isMarkedForReview: bool, isVisited: bool }
    const userState = {};
    allQuestions.forEach((item) => {
      userState[item.question.id] = {
        selectedOptionId: null,
        numericalValue: '',
        isAnswered: false,
        isMarkedForReview: false,
        isVisited: false,
      };
    });

    let activeSubject = 'physics';
    let activeQuestionIndex = 0; // global index
    let timerInterval = null;
    let timeRemainingSeconds = 180 * 60; // 3 hours
    let testStarted = false;
    let testSubmitted = false;

    // DOM Elements
    const viewStart = document.getElementById('jee-view-start');
    const viewExam = document.getElementById('jee-view-exam');
    const viewResult = document.getElementById('jee-view-result');
    const modalSubmit = document.getElementById('jee-modal-submit');
    const modalPapers = document.getElementById('jee-modal-papers');

    const tabPhysics = document.getElementById('tab-physics');
    const tabChem = document.getElementById('tab-chem');
    const tabMath = document.getElementById('tab-math');

    const timerText = document.getElementById('timer-text');
    const timerDisplay = document.getElementById('jee-timer-display');

    const currentQLabel = document.getElementById('current-q-label');
    const currentQSection = document.getElementById('current-q-section');
    const currentQText = document.getElementById('current-q-text');
    const currentQImageContainer = document.getElementById('current-q-image-container');
    const currentQImage = document.getElementById('current-q-image');
    const currentQOptions = document.getElementById('current-q-options');
    const currentQNumerical = document.getElementById('current-q-numerical');
    const numericalInput = document.getElementById('numerical-input');

    const paletteGrid = document.getElementById('jee-palette-grid');
    const paletteSecTitle = document.getElementById('palette-sec-title');

    function renderMath(target) {
      if (window.renderMathInElement) {
        try {
          window.renderMathInElement(target || document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\(', right: '\\)', display: false },
              { left: '\\[', right: '\\]', display: true },
            ],
            throwOnError: false,
          });
        } catch (err) {
          console.warn('LaTeX rendering notice:', err);
        }
      }
    }

    // Format Seconds to HH:MM:SS
    function formatTime(sec) {
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = sec % 60;
      const hh = h < 10 ? '0' + h : h;
      const mm = m < 10 ? '0' + m : m;
      const ss = s < 10 ? '0' + s : s;
      return `${hh}:${mm}:${ss}`;
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timeRemainingSeconds--;
        if (timerText) timerText.textContent = formatTime(timeRemainingSeconds);

        if (timeRemainingSeconds <= 900 && timerDisplay) {
          timerDisplay.classList.add('warning');
        }
        if (timeRemainingSeconds <= 300 && timerDisplay) {
          timerDisplay.classList.add('danger');
        }

        if (timeRemainingSeconds <= 0) {
          clearInterval(timerInterval);
          alert('Time is up! Your exam is being submitted.');
          submitExam();
        }
      }, 1000);
    }

    function switchSubject(subjectId) {
      activeSubject = subjectId;
      [tabPhysics, tabChem, tabMath].forEach((t) => {
        if (t) t.classList.toggle('active', t.getAttribute('data-subject') === subjectId);
      });

      const firstOfSubject = (questionsBySubject[subjectId] || [])[0];
      if (firstOfSubject) {
        loadQuestion(firstOfSubject.globalIndex);
      }
    }

    function loadQuestion(globalIdx) {
      if (globalIdx < 0 || globalIdx >= allQuestions.length) return;
      activeQuestionIndex = globalIdx;
      const item = allQuestions[globalIdx];
      const q = item.question;
      const state = userState[q.id];

      state.isVisited = true;

      // Update active tab if subject changed
      if (item.subjectId !== activeSubject) {
        activeSubject = item.subjectId;
        [tabPhysics, tabChem, tabMath].forEach((t) => {
          if (t) t.classList.toggle('active', t.getAttribute('data-subject') === activeSubject);
        });
      }

      // Meta labels
      if (currentQLabel) currentQLabel.textContent = `Question ${item.subjectIndex + 1} of 30`;
      if (currentQSection) currentQSection.textContent = `${item.subjectName} • ${item.sectionName}`;

      // Text
      if (currentQText) currentQText.textContent = q.questionText || '';

      // Image
      if (q.hasImage && q.imageName) {
        currentQImage.src = IMG_BASE_URL + q.imageName;
        currentQImage.alt = `Question ${item.subjectIndex + 1} Diagram`;
        currentQImageContainer.classList.remove('jee-hidden');
      } else {
        currentQImage.src = '';
        currentQImageContainer.classList.add('jee-hidden');
      }

      // Options or Numerical
      if (q.type === 'single_correct') {
        currentQNumerical.classList.add('jee-hidden');
        currentQOptions.classList.remove('jee-hidden');
        currentQOptions.innerHTML = '';

        const letters = ['A', 'B', 'C', 'D'];
        (q.options || []).forEach((opt, idx) => {
          const row = document.createElement('div');
          row.className = 'jee-option-row' + (state.selectedOptionId === opt.id ? ' selected' : '');
          row.setAttribute('data-opt-id', opt.id);

          row.innerHTML = `
            <span class="jee-option-letter">${letters[idx] || idx + 1}</span>
            <span class="jee-option-text">${opt.text || ''}</span>
          `;

          row.addEventListener('click', () => {
            currentQOptions.querySelectorAll('.jee-option-row').forEach((r) => r.classList.remove('selected'));
            row.classList.add('selected');
            state.selectedOptionId = opt.id;
            state.isAnswered = true;
            updateCounters();
            renderPalette();
          });

          currentQOptions.appendChild(row);
        });
      } else {
        // Numerical Question
        currentQOptions.classList.add('jee-hidden');
        currentQNumerical.classList.remove('jee-hidden');
        if (numericalInput) {
          numericalInput.value = state.numericalValue || '';
        }
      }

      // Render Math formulas in Question & Options
      renderMath(currentQText);
      renderMath(currentQOptions);

      updateCounters();
      renderPalette();
    }

    function renderPalette() {
      if (!paletteGrid) return;
      paletteGrid.innerHTML = '';

      const currentSubjectList = questionsBySubject[activeSubject] || [];
      const subName = activeSubject === 'physics' ? 'Physics' : activeSubject === 'chem' ? 'Chemistry' : 'Mathematics';
      if (paletteSecTitle) paletteSecTitle.textContent = `${subName} (Questions 1 - 30)`;

      currentSubjectList.forEach((item) => {
        const state = userState[item.question.id];
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'jee-q-btn';
        btn.textContent = String(item.subjectIndex + 1);

        if (item.globalIndex === activeQuestionIndex) {
          btn.classList.add('current');
        }

        // Palette Status Colors
        if (state.isAnswered && state.isMarkedForReview) {
          btn.classList.add('jee-p-badge--ans-review');
        } else if (state.isMarkedForReview) {
          btn.classList.add('jee-p-badge--review');
        } else if (state.isAnswered) {
          btn.classList.add('jee-p-badge--ans');
        } else if (state.isVisited) {
          btn.classList.add('jee-p-badge--not-ans');
        } else {
          btn.classList.add('jee-p-badge--not-vis');
        }

        btn.addEventListener('click', () => {
          loadQuestion(item.globalIndex);
          const drawer = document.getElementById('jee-palette-drawer');
          if (drawer && drawer.classList.contains('open')) {
            drawer.classList.remove('open');
          }
        });

        paletteGrid.appendChild(btn);
      });
    }

    function updateCounters() {
      ['physics', 'chem', 'math'].forEach((sId) => {
        const list = questionsBySubject[sId] || [];
        const ans = list.filter((item) => userState[item.question.id].isAnswered).length;
        const el = document.getElementById(`count-${sId}`);
        if (el) el.textContent = `${ans}/30`;
      });
    }

    // Save & Next Action
    function handleSaveAndNext() {
      const item = allQuestions[activeQuestionIndex];
      const state = userState[item.question.id];

      if (item.question.type === 'numerical' && numericalInput) {
        const val = numericalInput.value.trim();
        state.numericalValue = val;
        state.isAnswered = val.length > 0;
      }

      state.isVisited = true;
      state.isMarkedForReview = false;

      // Advance
      if (activeQuestionIndex < allQuestions.length - 1) {
        loadQuestion(activeQuestionIndex + 1);
      } else {
        openSubmitModal();
      }
    }

    // Mark For Review & Next Action
    function handleMarkForReview() {
      const item = allQuestions[activeQuestionIndex];
      const state = userState[item.question.id];

      if (item.question.type === 'numerical' && numericalInput) {
        const val = numericalInput.value.trim();
        state.numericalValue = val;
        state.isAnswered = val.length > 0;
      }

      state.isVisited = true;
      state.isMarkedForReview = true;

      if (activeQuestionIndex < allQuestions.length - 1) {
        loadQuestion(activeQuestionIndex + 1);
      } else {
        openSubmitModal();
      }
    }

    // Clear Response Action
    function handleClearResponse() {
      const item = allQuestions[activeQuestionIndex];
      const state = userState[item.question.id];
      state.selectedOptionId = null;
      state.numericalValue = '';
      state.isAnswered = false;
      state.isMarkedForReview = false;

      if (item.question.type === 'single_correct') {
        currentQOptions.querySelectorAll('.jee-option-row').forEach((r) => r.classList.remove('selected'));
      } else if (numericalInput) {
        numericalInput.value = '';
      }

      updateCounters();
      renderPalette();
    }

    // Open Submit Summary Modal
    function openSubmitModal() {
      if (!modalSubmit) return;
      const tbody = document.getElementById('submit-summary-tbody');
      if (tbody) {
        tbody.innerHTML = '';
        const subjects = [
          { id: 'physics', name: 'Physics' },
          { id: 'chem', name: 'Chemistry' },
          { id: 'math', name: 'Mathematics' },
        ];

        subjects.forEach((s) => {
          const list = questionsBySubject[s.id] || [];
          let ans = 0,
            notAns = 0,
            review = 0;
          list.forEach((item) => {
            const st = userState[item.question.id];
            if (st.isAnswered) ans++;
            else if (st.isVisited) notAns++;
            if (st.isMarkedForReview) review++;
          });
          const row = document.createElement('tr');
          row.innerHTML = `
            <td><strong>${s.name}</strong></td>
            <td>${list.length}</td>
            <td style="color:var(--jee-green);font-weight:700">${ans}</td>
            <td style="color:var(--jee-orange);font-weight:700">${notAns}</td>
            <td style="color:var(--jee-purple);font-weight:700">${review}</td>
          `;
          tbody.appendChild(row);
        });
      }
      modalSubmit.classList.remove('jee-hidden');
    }

    function closeSubmitModal() {
      if (modalSubmit) modalSubmit.classList.add('jee-hidden');
    }

    // Submit Exam & Calculate Scores
    function submitExam() {
      if (timerInterval) clearInterval(timerInterval);
      testSubmitted = true;
      closeSubmitModal();

      let totalScore = 0;
      let totalAttempted = 0;
      let totalCorrect = 0;
      let totalIncorrect = 0;

      const subjectStats = {
        physics: { score: 0, correct: 0, incorrect: 0, skipped: 0 },
        chem: { score: 0, correct: 0, incorrect: 0, skipped: 0 },
        math: { score: 0, correct: 0, incorrect: 0, skipped: 0 },
      };

      allQuestions.forEach((item) => {
        const q = item.question;
        const st = userState[q.id];
        const sId = item.subjectId;
        let isCorrect = false;

        if (q.type === 'single_correct') {
          if (st.selectedOptionId) {
            totalAttempted++;
            const chosen = (q.options || []).find((o) => o.id === st.selectedOptionId);
            if (chosen && chosen.isCorrect) {
              isCorrect = true;
              totalCorrect++;
              totalScore += item.marks;
              subjectStats[sId].correct++;
              subjectStats[sId].score += item.marks;
            } else {
              totalIncorrect++;
              totalScore += item.negativeMarks;
              subjectStats[sId].incorrect++;
              subjectStats[sId].score += item.negativeMarks;
            }
          } else {
            subjectStats[sId].skipped++;
          }
        } else {
          // Numerical
          const numStr = String(st.numericalValue ?? '').trim();
          const userVal = parseFloat(numStr);
          if (!isNaN(userVal) && numStr.length > 0) {
            totalAttempted++;
            const correctVal = parseFloat(q.answer);
            // Allow small epsilon tolerance for float answers
            if (Math.abs(userVal - correctVal) < 0.01) {
              isCorrect = true;
              totalCorrect++;
              totalScore += item.marks;
              subjectStats[sId].correct++;
              subjectStats[sId].score += item.marks;
            } else {
              totalIncorrect++;
              totalScore += item.negativeMarks;
              subjectStats[sId].incorrect++;
              subjectStats[sId].score += item.negativeMarks;
            }
          } else {
            subjectStats[sId].skipped++;
          }
        }

        item.userResult = {
          isAttempted: st.isAnswered,
          isCorrect: isCorrect,
          userOptionId: st.selectedOptionId,
          userNumVal: st.numericalValue,
        };
      });

      // Show Result View
      viewExam.classList.add('jee-hidden');
      viewResult.classList.remove('jee-hidden');

      // Populate Result Stats
      const resScoreEl = document.getElementById('res-total-score');
      if (resScoreEl) resScoreEl.textContent = String(totalScore);

      const acc = totalAttempted > 0 ? Math.round((totalCorrect / totalAttempted) * 100) : 0;
      const resAccEl = document.getElementById('res-accuracy');
      if (resAccEl) resAccEl.textContent = `${acc}%`;

      const resAttEl = document.getElementById('res-attempted');
      if (resAttEl) resAttEl.textContent = `${totalAttempted} / 90`;

      const resCorEl = document.getElementById('res-correct');
      if (resCorEl) resCorEl.textContent = String(totalCorrect);

      const resIncEl = document.getElementById('res-incorrect');
      if (resIncEl) resIncEl.textContent = String(totalIncorrect);

      const resUnEl = document.getElementById('res-unattempted');
      if (resUnEl) resUnEl.textContent = String(90 - totalAttempted);

      const timeTakenSec = 180 * 60 - timeRemainingSeconds;
      const resTimeEl = document.getElementById('res-time-taken');
      if (resTimeEl) resTimeEl.textContent = formatTime(timeTakenSec);

      // Subject stats
      ['physics', 'chem', 'math'].forEach((sId) => {
        const sc = subjectStats[sId];
        const sEl = document.getElementById(`res-${sId}-score`);
        if (sEl) sEl.textContent = `${sc.score} / 100`;
        const cEl = document.getElementById(`res-${sId}-correct`);
        if (cEl) cEl.textContent = `Correct: ${sc.correct}`;
        const iEl = document.getElementById(`res-${sId}-incorrect`);
        if (iEl) iEl.textContent = `Incorrect: ${sc.incorrect}`;
        const kEl = document.getElementById(`res-${sId}-skipped`);
        if (kEl) kEl.textContent = `Skipped: ${sc.skipped}`;
      });

      // Render Solutions
      renderSolutions('all');

      window.scrollTo({ top: viewResult.offsetTop - 50, behavior: 'smooth' });
    }

    // Render Detailed Solutions
    function renderSolutions(filter) {
      const listContainer = document.getElementById('jee-solutions-list');
      if (!listContainer) return;
      listContainer.innerHTML = '';

      allQuestions.forEach((item, idx) => {
        const q = item.question;
        const res = item.userResult;

        let statusClass = 'unattempted';
        let statusText = 'Not Attempted (0 Marks)';
        if (res.isAttempted) {
          if (res.isCorrect) {
            statusClass = 'correct';
            statusText = `Correct (+${item.marks} Marks)`;
          } else {
            statusClass = 'incorrect';
            statusText = `Incorrect (${item.negativeMarks} Mark)`;
          }
        }

        // Apply filters
        if (filter === 'correct' && statusClass !== 'correct') return;
        if (filter === 'incorrect' && statusClass !== 'incorrect') return;
        if (filter === 'unattempted' && statusClass !== 'unattempted') return;
        if (filter === 'physics' && item.subjectId !== 'physics') return;
        if (filter === 'chem' && item.subjectId !== 'chem') return;
        if (filter === 'math' && item.subjectId !== 'math') return;

        const card = document.createElement('div');
        card.className = `jee-solution-card ${statusClass}`;

        let imgHtml = '';
        if (q.hasImage && q.imageName) {
          imgHtml = `
            <div class="jee-q-image-wrap">
              <img src="${IMG_BASE_URL + q.imageName}" alt="Solution diagram for Question ${idx + 1}" loading="lazy" />
            </div>
          `;
        }

        let answersHtml = '';
        if (q.type === 'single_correct') {
          const chosenOpt = (q.options || []).find((o) => o.id === res.userOptionId);
          const correctOpt = (q.options || []).find((o) => o.isCorrect);

          answersHtml = `
            <div class="jee-sol-answers-grid">
              <div>
                <strong>Your Answer:</strong> ${chosenOpt ? chosenOpt.text : '<span style="color:var(--jee-gray)">Not Attempted</span>'}
              </div>
              <div>
                <strong style="color:var(--jee-green)">Correct Answer:</strong> ${correctOpt ? correctOpt.text : 'N/A'}
              </div>
            </div>
          `;
        } else {
          answersHtml = `
            <div class="jee-sol-answers-grid">
              <div>
                <strong>Your Answer:</strong> ${String(res.userNumVal ?? '').trim() ? String(res.userNumVal) : '<span style="color:var(--jee-gray)">Not Attempted</span>'}
              </div>
              <div>
                <strong style="color:var(--jee-green)">Correct Numerical Answer:</strong> ${q.answer}
              </div>
            </div>
          `;
        }

        card.innerHTML = `
          <div class="jee-sol-head">
            <div>
              <strong>Q${idx + 1}.</strong> <span>${item.subjectName} • ${item.sectionName}</span>
            </div>
            <span class="jee-sol-status ${statusClass}">${statusText}</span>
          </div>
          <div class="jee-q-text">${q.questionText || ''}</div>
          ${imgHtml}
          ${answersHtml}
          <div class="jee-explanation-box">
            <h4>Step-by-Step Explanation &amp; Solution:</h4>
            <div class="jee-explanation-content">${q.explanation || 'Detailed explanation not available.'}</div>
          </div>
        `;

        listContainer.appendChild(card);
      });

      renderMath(listContainer);
    }

    // Modal Papers List (24 papers)
    function populatePapersModal() {
      const container = document.getElementById('jee-manifest-papers-list');
      if (!container || !manifest || !manifest.papers) return;
      container.innerHTML = '';

      manifest.papers.forEach((p, idx) => {
        const item = document.createElement('div');
        item.className = 'jee-paper-item' + (idx === 0 ? ' active-paper' : '');

        item.innerHTML = `
          <div>
            <span class="jee-paper-title">${p.title || 'JEE Mock Test'}</span>
            <span class="jee-paper-desc">${p.description || `Year: ${p.year}`}</span>
          </div>
          <div>
            ${
              idx === 0
                ? `<span class="jee-badge jee-badge--primary">Active Online Now</span>`
                : `<a href="${APP_URL}" target="_blank" rel="noopener noreferrer" class="jee-btn jee-btn--app" style="font-size:0.75rem;padding:0.4rem 0.8rem">
                    <span>Take on App</span>
                  </a>`
            }
          </div>
        `;
        container.appendChild(item);
      });
    }

    // Wire Up Event Listeners
    function initEvents() {
      // Start Exam Button
      const btnStart = document.getElementById('btn-start-exam');
      if (btnStart) {
        btnStart.addEventListener('click', () => {
          viewStart.classList.add('jee-hidden');
          viewExam.classList.remove('jee-hidden');
          testStarted = true;
          loadQuestion(0);
          startTimer();
          window.scrollTo({ top: viewExam.offsetTop - 50, behavior: 'smooth' });
        });
      }

      // Subject Tabs
      if (tabPhysics) tabPhysics.addEventListener('click', () => switchSubject('physics'));
      if (tabChem) tabChem.addEventListener('click', () => switchSubject('chem'));
      if (tabMath) tabMath.addEventListener('click', () => switchSubject('math'));

      // Navigation & Save Actions
      const btnPrev = document.getElementById('btn-prev-q');
      if (btnPrev) {
        btnPrev.addEventListener('click', () => {
          if (activeQuestionIndex > 0) loadQuestion(activeQuestionIndex - 1);
        });
      }

      const btnSaveNext = document.getElementById('btn-save-next');
      if (btnSaveNext) btnSaveNext.addEventListener('click', handleSaveAndNext);

      const btnMarkReview = document.getElementById('btn-mark-review');
      if (btnMarkReview) btnMarkReview.addEventListener('click', handleMarkForReview);

      const btnClear = document.getElementById('btn-clear-response');
      if (btnClear) btnClear.addEventListener('click', handleClearResponse);

      // Virtual Keypad
      document.querySelectorAll('.jee-key').forEach((key) => {
        key.addEventListener('click', () => {
          if (!numericalInput) return;
          const k = key.getAttribute('data-key');
          if (k === 'backspace') {
            numericalInput.value = numericalInput.value.slice(0, -1);
          } else if (k === 'clear') {
            numericalInput.value = '';
          } else {
            numericalInput.value += k;
          }
          const item = allQuestions[activeQuestionIndex];
          userState[item.question.id].numericalValue = numericalInput.value;
          userState[item.question.id].isAnswered = numericalInput.value.trim().length > 0;
          updateCounters();
          renderPalette();
        });
      });

      if (numericalInput) {
        numericalInput.addEventListener('input', () => {
          const item = allQuestions[activeQuestionIndex];
          userState[item.question.id].numericalValue = numericalInput.value;
          userState[item.question.id].isAnswered = numericalInput.value.trim().length > 0;
          updateCounters();
          renderPalette();
        });
      }

      // Submit Modals
      const btnSubmitTop = document.getElementById('btn-submit-exam-top');
      if (btnSubmitTop) btnSubmitTop.addEventListener('click', openSubmitModal);

      const btnSubmitSide = document.getElementById('btn-submit-exam-side');
      if (btnSubmitSide) btnSubmitSide.addEventListener('click', openSubmitModal);

      const btnCancelSubmit = document.getElementById('btn-cancel-submit');
      if (btnCancelSubmit) btnCancelSubmit.addEventListener('click', closeSubmitModal);

      const backdropSubmit = document.getElementById('modal-submit-backdrop');
      if (backdropSubmit) backdropSubmit.addEventListener('click', closeSubmitModal);

      const btnConfirmSubmit = document.getElementById('btn-confirm-submit');
      if (btnConfirmSubmit) btnConfirmSubmit.addEventListener('click', submitExam);

      // Toggle Palette on Mobile
      const btnTogglePalette = document.getElementById('btn-toggle-palette');
      const paletteDrawer = document.getElementById('jee-palette-drawer');
      if (btnTogglePalette && paletteDrawer) {
        btnTogglePalette.addEventListener('click', () => {
          paletteDrawer.classList.toggle('open');
        });
      }

      // Solutions Filters
      document.querySelectorAll('.jee-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.jee-filter-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const filter = btn.getAttribute('data-filter');
          renderSolutions(filter);
        });
      });

      // Retake Test
      const btnRetake = document.getElementById('btn-retake-exam');
      if (btnRetake) {
        btnRetake.addEventListener('click', () => {
          if (confirm('Are you sure you want to retake the test? Your previous answers will be reset.')) {
            allQuestions.forEach((item) => {
              userState[item.question.id] = {
                selectedOptionId: null,
                numericalValue: '',
                isAnswered: false,
                isMarkedForReview: false,
                isVisited: false,
              };
            });
            timeRemainingSeconds = 180 * 60;
            if (timerDisplay) timerDisplay.classList.remove('warning', 'danger');
            viewResult.classList.add('jee-hidden');
            viewExam.classList.remove('jee-hidden');
            loadQuestion(0);
            startTimer();
            window.scrollTo({ top: viewExam.offsetTop - 50, behavior: 'smooth' });
          }
        });
      }

      // Scroll to Solutions
      const btnScrollSol = document.getElementById('btn-scroll-solutions');
      const solSection = document.getElementById('jee-solutions-section');
      if (btnScrollSol && solSection) {
        btnScrollSol.addEventListener('click', () => {
          solSection.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // Print Scorecard
      const btnPrint = document.getElementById('btn-print-result');
      if (btnPrint) {
        btnPrint.addEventListener('click', () => window.print());
      }

      // Papers Modal
      const btnBrowsePapers = document.getElementById('btn-browse-papers');
      const btnClosePapers = document.getElementById('btn-close-papers-modal');
      const backdropPapers = document.getElementById('modal-papers-backdrop');

      if (btnBrowsePapers && modalPapers) {
        btnBrowsePapers.addEventListener('click', () => {
          populatePapersModal();
          modalPapers.classList.remove('jee-hidden');
        });
      }

      if (btnClosePapers && modalPapers) {
        btnClosePapers.addEventListener('click', () => modalPapers.classList.add('jee-hidden'));
      }

      if (backdropPapers && modalPapers) {
        backdropPapers.addEventListener('click', () => modalPapers.classList.add('jee-hidden'));
      }
    }

    // Initial Execution
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initEvents();
        renderMath();
      });
    } else {
      initEvents();
      renderMath();
    }

    // Retry KaTeX render once window completes full load (in case CDN script finished later)
    window.addEventListener('load', () => {
      renderMath();
    });
  })();
</script>
