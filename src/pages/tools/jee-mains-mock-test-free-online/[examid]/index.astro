</style>

<script is:inline>
  (function () {
    // KaTeX Math Rendering
    function renderMath() {
      if (window.renderMathInElement) {
        try {
          window.renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\(', right: '\\)', display: false },
              { left: '\\[', right: '\\]', display: true },
            ],
            throwOnError: false,
          });
        } catch (e) {
          console.warn('KaTeX render note:', e);
        }
      }
    }

    // Filter Logic
    let activeFilter = 'all';
    let searchQuery = '';

    const filterTabs = document.querySelectorAll('.jee-filter-tab');
    const searchInput = document.getElementById('sol-search-input');
    const questionCards = document.querySelectorAll('.jee-q-card');
    const jumpBtns = document.querySelectorAll('.jee-jump-btn');
    const countBadge = document.getElementById('visible-count-badge');

    function applyFilters() {
      let visible = 0;
      const q = searchQuery.toLowerCase().trim();

      questionCards.forEach((card) => {
        const sub = card.getAttribute('data-subject');
        const type = card.getAttribute('data-type');
        const text = card.textContent.toLowerCase();

        let matchesTab = true;
        if (activeFilter === 'physics' && sub !== 'physics') matchesTab = false;
        else if (activeFilter === 'chem' && sub !== 'chem') matchesTab = false;
        else if (activeFilter === 'math' && sub !== 'math') matchesTab = false;
        else if (activeFilter === 'mcq' && type !== 'mcq') matchesTab = false;
        else if (activeFilter === 'numerical' && type !== 'numerical') matchesTab = false;

        let matchesSearch = true;
        if (q.length > 0 && !text.includes(q)) {
          matchesSearch = false;
        }

        const isShown = matchesTab && matchesSearch;
        card.classList.toggle('is-hidden', !isShown);
        if (isShown) visible++;

        // Sync Jump Button state
        const qNum = card.getAttribute('data-qnum');
        const jumpBtn = document.querySelector(`.jee-jump-btn[data-target="q-card-${qNum}"]`);
        if (jumpBtn) {
          jumpBtn.style.display = isShown ? 'flex' : 'none';
        }
      });

      if (countBadge) {
        countBadge.textContent = `Showing ${visible} of 90 Questions`;
      }
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        activeFilter = tab.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        applyFilters();
      });
    }

    // Jump Buttons
    jumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetEl.classList.add('highlight');
          setTimeout(() => targetEl.classList.remove('highlight'), 2000);
        }
      });
    });

    // Print Button
    const btnPrint = document.getElementById('btn-print-solutions');
    if (btnPrint) {
      btnPrint.addEventListener('click', () => window.print());
    }

    // Initial Math Render
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderMath);
    } else {
      renderMath();
    }
    window.addEventListener('load', renderMath);
  })();
</script>
