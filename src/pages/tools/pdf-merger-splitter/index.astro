  }

  .guide-section h2 {
    font-size: 1.45rem;
    font-weight: 700;
    margin: 1.5rem 0 0.75rem 0;
  }

  .guide-section p {
    line-height: 1.6;
    color: var(--md-sys-color-on-surface-variant, #49454F);
    margin-bottom: 1rem;
