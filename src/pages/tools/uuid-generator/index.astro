---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { getTool, toolSeo, makeFaqSchema, makeHowToSchema } from '../../../data/tools';
import { SITE_URL } from '../../../data/site';

const tool = getTool('uuid-generator')!;

const steps = [
  {
    title: 'Select Identifier Type & Quantity',
    description: 'Choose between UUID v4 (random), UUID v7 (timestamp-ordered), ULID (Lexicographically Sortable), or NanoID. Set your desired batch count from 1 to 500.',
  },
  {
    title: 'Customize Output Formatting',
    description: 'Toggle uppercase or lowercase output, include or exclude hyphens, or wrap identifiers in quotes or brackets according to your code configuration.',
  },
  {
    title: 'Inspect & Decode Timestamps',
    description: 'Paste any UUID v7 or ULID string into the Inspector panel to immediately decode its embedded millisecond timestamp and extract the exact creation date.',
  },
  {
    title: 'Copy or Download Results',
    description: 'Copy generated IDs directly to your clipboard or export them as clean .txt files or structured JSON arrays.',
  },
];

const faqSchema = makeFaqSchema([
  {
    question: 'Is my generated UUID or NanoID data private and secure?',
    answer: 'Yes, 100%. All identifier generation, formatting, and timestamp parsing executes completely in your local browser memory using native Web Crypto APIs. No data is ever transmitted to remote servers.',
  },
  {
    question: 'What is the main difference between UUID v4 and UUID v7?',
    answer: 'UUID v4 is completely random with 122 bits of entropy. UUID v7 embeds a 48-bit millisecond timestamp at the beginning followed by random bits, ensuring chronological sorting in database primary key indexes to eliminate B-tree fragmentation.',
  },
  {
    question: 'How does ULID differ from NanoID?',
    answer: 'ULID is a 128-bit identifier encoded as 26 Crockford Base32 characters that includes a 48-bit timestamp for sorting. NanoID is a compact, customizable string (default 21 chars) optimized for URL safety and minimal footprint.',
  },
  {
    question: 'Can I extract the creation time from any UUID?',
    answer: 'You can extract precise creation timestamps from time-based identifier formats like UUID v1, UUID v6, UUID v7, and ULID. Random formats like UUID v4 do not store timestamp metadata.',
  },
]);

const howToSchema = makeHowToSchema(
  'How to Generate and Inspect UUIDs, ULIDs, and NanoIDs Online',
  'Step-by-step guide to generating cryptographically secure UUID v4, UUID v7, ULID, and NanoID strings with instant timestamp decoding.',
  steps
);

const seo = toolSeo(tool, {
  title: 'UUID & NanoID Generator – Bulk UUID v4, v7, ULID & Inspector',
  description:
    'Generate cryptographically secure UUID v4, v7, ULID, and NanoID strings online. Inspect timestamps and format bulk IDs with 100% in-browser privacy.',
  keywords:
    'uuid generator, uuid v7 generator, nanoid generator, ulid generator, uuid inspector, bulk uuid generator, timestamp ordered uuid, online uuid tool, ni18',
  author: 'ni18',
  ogTitle: 'UUID & NanoID Generator – Bulk UUID v4, v7, ULID & Inspector',
  ogDescription:
    'Generate bulk UUID v4, v7, ULID, and NanoID strings online. Inspect timestamps and format bulk IDs with 100% client-side Web Crypto privacy.',
  twitterDomain: 'online-tools.ni18.in',
  appSchema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'UUID & NanoID Generator / Inspector',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    url: `${SITE_URL}/tools/uuid-generator/`,
    description:
      'Generate cryptographically secure UUID v4, v7, ULID, and NanoID strings. Inspect and decode timestamps from UUID v7 and ULIDs with zero server uploads.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  extraJsonLd: [howToSchema, faqSchema],
});

const altLinks = {
  es: `${SITE_URL}/es/tools/generador-uuid/`,
  fr: `${SITE_URL}/fr/tools/generateur-uuid/`,
};
---

<ToolLayout seo={seo} lang="en" altLinks={altLinks}>
  <div class="tool-island" id="tool-uuid-generator">
    <header class="tool-header">
      <h1>UUID & NanoID Generator / Inspector</h1>
      <p class="subtitle">Cryptographically secure UUID v4, UUID v7, ULID, and NanoID bulk generation with timestamp inspection</p>
    </header>

    <!-- Quick Action Bar -->
    <div class="quick-actions">
      <button type="button" class="action-btn" id="btn-generate">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
        <span>Generate New Batch</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-sample">
        <span>Load Sample</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-clear">
        <span>Clear</span>
      </button>
    </div>

    <!-- Main Workspace -->
    <div class="workspace-grid">
      <!-- Controls & Generator Section -->
      <section class="pane input-pane" aria-labelledby="controls-heading">
        <div class="pane-header">
          <h2 id="controls-heading">Configuration & Generator</h2>
        </div>

        <div class="control-group">
          <label for="id-type">Identifier Format</label>
          <select id="id-type" class="form-select">
            <option value="v4" selected>UUID v4 (Random - RFC 4122)</option>
            <option value="v7">UUID v7 (Timestamp-Ordered - RFC 9562)</option>
            <option value="ulid">ULID (Lexicographically Sortable)</option>
            <option value="nanoid">NanoID (Compact URL-Safe)</option>
          </select>
        </div>

        <div class="control-row">
          <div class="control-group half">
            <label for="id-count">Quantity (1 - 500)</label>
            <input type="number" id="id-count" value="10" min="1" max="500" class="form-input" />
          </div>
          <div class="control-group half" id="nanoid-length-wrap" style="display:none;">
            <label for="nanoid-length">NanoID Length</label>
            <input type="number" id="nanoid-length" value="21" min="6" max="64" class="form-input" />
          </div>
        </div>

        <div class="options-grid">
          <label class="checkbox-label">
            <input type="checkbox" id="opt-uppercase" />
            <span>Uppercase</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="opt-hyphens" checked />
            <span>Hyphens (UUID)</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="opt-quotes" />
            <span>Enclose in Quotes</span>
          </label>
        </div>

        <div class="pane-header sub-header margin-top">
          <h2>UUID / ULID Inspector & Timestamp Decoder</h2>
        </div>
        <div class="control-group">
          <input type="text" id="inspect-input" class="form-input" placeholder="Paste UUID v7 or ULID to extract timestamp..." spellcheck="false" />
        </div>
        <div id="inspect-result" class="inspect-box">
          <div class="inspect-row"><span class="inspect-label">Detected Format:</span> <span id="insp-format" class="badge">None</span></div>
          <div class="inspect-row"><span class="inspect-label">Timestamp (UTC):</span> <span id="insp-date" class="inspect-val">-</span></div>
          <div class="inspect-row"><span class="inspect-label">Unix Epoch:</span> <span id="insp-epoch" class="inspect-val">-</span></div>
        </div>

        <div id="status-error" class="error-banner" style="display:none;" role="alert">
          <span id="error-message">Invalid configuration or ID format.</span>
        </div>
      </section>

      <!-- Output Section -->
      <section class="pane output-pane" aria-labelledby="output-heading">
        <div class="pane-header">
          <h2 id="output-heading">Generated Output</h2>
          <div class="output-actions">
            <button type="button" class="copy-btn" id="btn-copy"><span>Copy All</span></button>
            <button type="button" class="copy-btn action-btn--secondary" id="btn-download-txt"><span>.TXT</span></button>
            <button type="button" class="copy-btn action-btn--secondary" id="btn-download-json"><span>.JSON</span></button>
          </div>
        </div>
        <div class="output-wrap">
          <textarea id="output-text" class="output-textarea" readonly spellcheck="false"></textarea>
        </div>
        <div class="output-meta">
          <span id="output-count-badge" class="count-badge">0 IDs generated</span>
        </div>
      </section>
    </div>

    <!-- Educational Guide & FAQs (SEO Content) -->
    <article class="guide-section">
      <h2>How to Use the UUID & NanoID Generator</h2>
      <p>Whether you are designing database schemas, configuring API endpoints, or generating secure session tokens, selecting the right unique identifier standard is crucial for system performance. This tool generates cryptographically secure random and time-ordered IDs completely inside your web browser.</p>

      <div class="features-grid">
        <div class="feature-card">
          <h3>⚡ 100% Client-Side Web Crypto</h3>
          <p>Utilizes native browser <code>crypto.getRandomValues</code> API for maximum cryptographic entropy. Zero data or keys are transmitted to any remote server.</p>
        </div>
        <div class="feature-card">
          <h3>⏱️ UUID v7 & ULID Time Extraction</h3>
          <p>Extract precise millisecond timestamps from timestamp-ordered formats (UUID v7 and ULID) to audit record creation times instantly.</p>
        </div>
        <div class="feature-card">
          <h3>📦 Bulk Export & Custom Options</h3>
          <p>Generate up to 500 identifiers at once. Customize capitalization, hyphens, and quotes, then export as clean text or JSON arrays.</p>
        </div>
      </div>

      <h2>Step-by-Step Instructions</h2>
      <ol class="steps-list">
        <li><strong>Step 1: Choose Your Format:</strong> Select UUID v4 for random tokens, UUID v7 or ULID for database primary keys needing chronological sorting, or NanoID for compact URLs.</li>
        <li><strong>Step 2: Configure Formatting:</strong> Set the generation batch size and toggle uppercase lettering, hyphens, or quote wrapping.</li>
        <li><strong>Step 3: Copy or Export:</strong> Instantly copy the output to your clipboard or download formatted .TXT and .JSON files for developer workflows.</li>
        <li><strong>Step 4: Inspect Identifiers:</strong> Paste existing UUID v7 or ULID strings into the Inspector input to reveal embedded creation dates and epoch timestamps.</li>
      </ol>

      <h2>Technical Deep-Dive: UUID v4 vs UUID v7 vs ULID</h2>
      <p>Traditionally, <strong>UUID v4</strong> (RFC 4122) has been the default standard for unique keys across web applications. While offering 122 bits of cryptographic randomness, UUID v4 keys are completely unordered. Inserting random UUID v4 keys into database B-tree primary key indexes (such as PostgreSQL or MySQL InnoDB) causes severe index fragmentation and frequent page splits under high write throughput.</p>

      <p><strong>UUID v7</strong> (RFC 9562) solves this bottleneck by combining a 48-bit Unix epoch millisecond timestamp in the leading bits with 74 bits of cryptographically secure random data. This ensures that newly generated keys always sort after older keys, preserving sequential B-tree insertion performance while retaining global uniqueness across distributed systems.</p>

      <p>Similarly, <strong>ULID</strong> (Universally Unique Lexicographically Sortable Identifier) uses a 48-bit timestamp and 80 bits of randomness encoded in 26 Crockford Base32 characters. <strong>NanoID</strong> offers a smaller 21-character string using a custom URL-safe alphabet (A-Za-z0-9_-) with comparable collision resistance to UUID v4.</p>

      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Is my generated data private and secure?</summary>
          <p>Yes, 100%. All processing occurs strictly within your browser memory using the native Web Cryptography API. No network calls or server requests are made.</p>
        </details>
        <details class="faq-item">
          <summary>When should I use UUID v7 instead of UUID v4?</summary>
          <p>Use UUID v7 when storing identifiers as primary keys in relational databases or indexed document stores. Time ordering prevents index page splitting and significantly improves write query speeds.</p>
        </details>
        <details class="faq-item">
          <summary>Can NanoID replace UUID v4?</summary>
          <p>Yes. NanoID produces shorter, URL-friendly strings (21 chars vs 36 chars) with equivalent or higher entropy, making it ideal for web URLs, file names, and frontend keys.</p>
        </details>
        <details class="faq-item">
          <summary>How does timestamp decoding work in UUID v7?</summary>
          <p>The first 48 bits (12 hex characters) of a UUID v7 represent the Unix timestamp in milliseconds. The Inspector extracts these bits, converts them to a numeric epoch, and formats them into a readable UTC date.</p>
        </details>
      </div>
    </article>
  </div>
</ToolLayout>

<style>
  #tool-uuid-generator { max-width: 1080px; margin: 0 auto; }
  .tool-header { text-align: center; margin-bottom: 24px; }
  .tool-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 700; margin: 0 0 8px; color: var(--md-sys-color-on-surface); }
  .subtitle { font-size: 1rem; color: var(--md-sys-color-on-surface-variant); margin: 0; }

  .quick-actions { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; justify-content: center; }
  .action-btn, .copy-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
    border-radius: var(--md-sys-shape-corner-small, 8px); font-size: 0.875rem; font-weight: 500;
    cursor: pointer; border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface);
    transition: background 0.15s, border-color 0.15s;
  }
  .action-btn:hover, .copy-btn:hover { background: var(--md-sys-color-surface-container-highest); border-color: var(--md-sys-color-primary); }
  .action-btn--secondary { background: var(--md-sys-color-surface-container-low); }

  .workspace-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 36px; }
  .pane { background: var(--md-sys-color-surface-container-lowest); border: 1px solid var(--md-sys-color-outline-variant); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; }
  .pane-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
  .pane-header h2 { font-size: 1.1rem; font-weight: 600; margin: 0; color: var(--md-sys-color-on-surface); }
  .sub-header { border-top: 1px solid var(--md-sys-color-outline-variant); padding-top: 16px; }
  .margin-top { margin-top: 20px; }

  .control-group { margin-bottom: 14px; display: flex; flex-direction: column; gap: 6px; }
  .control-group label { font-size: 0.85rem; font-weight: 600; color: var(--md-sys-color-on-surface-variant); }
  .control-row { display: flex; gap: 12px; }
  .control-row .half { flex: 1; }

