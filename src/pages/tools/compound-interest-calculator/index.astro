---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { getTool, toolSeo } from '../../../data/tools';
import { SITE_URL } from '../../../data/site';

const tool = getTool('compound-interest-calculator')!;

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Calculate Compound Interest and Investment Growth',
  description: 'Learn how to calculate compound interest and future investment returns using starting principal, monthly deposits, and interest rates.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Enter Initial Principal',
      text: 'Input the initial sum of money you are investing or depositing upfront.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Set Monthly Contribution (Optional)',
      text: 'Add any recurring monthly deposits or SIP contributions you plan to invest regularly.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Select Annual Interest Rate and Time Horizon',
      text: 'Enter the estimated annual rate of return (e.g., 7%–10% for stock index funds) and duration in years.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Choose Compounding Frequency and Review Amortization',
      text: 'Select monthly or annual compounding to instantly view your future balance, growth chart, and year-by-year schedule.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is compound interest and how does it work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Compound interest is interest calculated on the initial principal and also on the accumulated interest from previous periods. Over long time horizons, this creates an exponential growth curve often termed the eighth wonder of the world.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the formula for compound interest with regular contributions?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The future balance combines principal compounding A = P(1 + r/n)^(nt) with the future value of a series of contributions PMT * (((1 + r/n)^(nt) - 1) / (r/n)).',
      },
    },
    {
      '@type': 'Question',
      name: 'How often does interest compound in high-yield savings accounts vs index funds?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'High-yield savings accounts and CDs typically compound daily or monthly. Stock market index funds (like S&P 500 ETFs) reinvest dividends quarterly or annually, with capital appreciation compounding continuously.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is my financial data kept private?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All calculations, amortization schedules, and growth graphs are processed 100% locally in your web browser. No financial data is ever transmitted to a server.',
      },
    },
  ],
};

const seo = toolSeo(tool, {
  title: 'Compound Interest & Investment Calculator – SIP & Growth Chart',
  description:
    'Calculate compound interest, monthly investments (SIP), and future value with interactive growth charts and year-by-year amortization schedules.',
  keywords:
    'compound interest calculator, investment calculator, sip calculator, interest growth chart, future value calculator, savings calculator, retirement calculator',
  author: 'ni18',
  schemaType: 'WebApplication',
  extraJsonLd: [howToSchema, faqSchema],
});

const altLinks = {
  es: `${SITE_URL}/es/tools/calculadora-interes-compuesto/`,
  fr: `${SITE_URL}/fr/tools/calculateur-interet-compose/`,
};
---

<ToolLayout seo={seo} lang="en" altLinks={altLinks}>
  <div class="tool-island" id="tool-compound-interest-calculator">
    <header class="tool-header">
      <h1>Compound Interest & Investment Calculator</h1>
      <p class="subtitle">Simulate future wealth, compound growth, and regular monthly contributions with visual charts</p>
    </header>

    <!-- Quick Presets -->
    <div class="quick-presets" aria-label="Preset investment scenarios">
      <span class="preset-label">Quick Scenarios:</span>
      <button type="button" class="preset-btn active" data-preset="sp500">
        <span>📈 S&P 500 Index ($500/mo @ 8%, 25y)</span>
      </button>
      <button type="button" class="preset-btn" data-preset="hysa">
        <span>🏦 High-Yield Savings ($10k @ 4.5%, 5y)</span>
      </button>
      <button type="button" class="preset-btn" data-preset="millionaire">
        <span>🚀 Millionaire Path ($1,000/mo @ 10%, 20y)</span>
      </button>
      <button type="button" class="preset-btn" data-preset="college">
        <span>🎓 College Fund ($250/mo @ 7%, 18y)</span>
      </button>
    </div>

    <div class="calc-grid">
      <!-- Input Controls Section -->
      <section class="calc-card inputs-card" aria-labelledby="heading-inputs">
        <h2 id="heading-inputs" class="card-title">Investment Parameters</h2>

        <div class="form-group">
          <label for="initial-principal">
            <span>Initial Deposit / Principal ($)</span>
            <span class="tooltip-icon" title="The upfront amount you invest today">ℹ️</span>
          </label>
          <div class="input-currency">
            <span class="currency-symbol">$</span>
            <input
              type="number"
              id="initial-principal"
              class="form-input"
              value="5000"
              min="0"
              max="10000000"
              step="100"
              aria-label="Initial Principal Amount"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="monthly-contribution">
            <span>Monthly Contribution / SIP ($)</span>
            <span class="tooltip-icon" title="Amount added to your investment every month">ℹ️</span>
          </label>
          <div class="input-currency">
            <span class="currency-symbol">$</span>
            <input
              type="number"
              id="monthly-contribution"
              class="form-input"
              value="500"
              min="0"
              max="500000"
              step="50"
              aria-label="Monthly Contribution"
            />
          </div>
        </div>

        <div class="form-group">
          <div class="label-with-val">
            <label for="interest-rate">Estimated Annual Interest Rate (%)</label>
            <span class="slider-val" id="rate-display">8.0%</span>
          </div>
          <div class="slider-wrap">
            <input
              type="range"
              id="interest-rate-slider"
              min="0.1"
              max="25"
              step="0.1"
              value="8.0"
              class="range-slider"
              aria-label="Interest rate slider"
            />
            <input
              type="number"
              id="interest-rate"
              class="form-input form-input--compact"
              value="8.0"
              min="0.1"
              max="50"
              step="0.1"
              aria-label="Annual Interest Rate percentage"
            />
          </div>
        </div>

        <div class="form-group">
          <div class="label-with-val">
            <label for="investment-years">Investment Time Horizon</label>
            <span class="slider-val" id="years-display">25 Years</span>
          </div>
          <div class="slider-wrap">
            <input
              type="range"
              id="investment-years-slider"
              min="1"
              max="50"
              step="1"
              value="25"
              class="range-slider"
              aria-label="Investment duration in years slider"
            />
            <input
              type="number"
              id="investment-years"
              class="form-input form-input--compact"
              value="25"
              min="1"
              max="60"
              step="1"
              aria-label="Investment duration in years"
            />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group half-group">
            <label for="compound-frequency">Compounding Frequency</label>
            <select id="compound-frequency" class="form-select" aria-label="Compounding Frequency">
              <option value="12" selected>Monthly (12x/yr)</option>
              <option value="1">Annually (1x/yr)</option>
              <option value="2">Semi-Annually (2x/yr)</option>
              <option value="4">Quarterly (4x/yr)</option>
              <option value="365">Daily (365x/yr)</option>
            </select>
          </div>

          <div class="form-group half-group">
            <label for="currency-select">Display Currency</label>
            <select id="currency-select" class="form-select" aria-label="Display Currency">
              <option value="USD" selected>USD ($)</option>
              <option value="EUR">EUR (€)</option>
              <option value="GBP">GBP (£)</option>
              <option value="INR">INR (₹)</option>
              <option value="CAD">CAD ($)</option>
              <option value="AUD">AUD ($)</option>
            </select>
          </div>
        </div>
      </section>

      <!-- Results & Breakdown Section -->
      <section class="calc-card results-card" aria-labelledby="heading-results">
        <h2 id="heading-results" class="card-title">Investment Summary</h2>

        <!-- Big Highlight Stat -->
        <div class="highlight-stat">
          <span class="stat-caption">Projected Future Value</span>
          <div class="stat-number" id="res-future-value">$478,574</div>
          <div class="stat-badge" id="res-total-gain">+208.8% Total Return</div>
        </div>

        <!-- 3-Column Metrics Breakdown -->
        <div class="summary-stats-grid">
          <div class="stat-box">
            <span class="box-label">Initial Deposit</span>
            <span class="box-value" id="res-initial-principal">$5,000</span>
          </div>
          <div class="stat-box">
            <span class="box-label">Total Monthly Added</span>
            <span class="box-value" id="res-total-contributions">$150,000</span>
          </div>
          <div class="stat-box stat-box--accent">
            <span class="box-label">Total Interest Earned</span>
            <span class="box-value" id="res-total-interest">$323,574</span>
          </div>
        </div>

        <!-- Ratio Visual Bar -->
        <div class="ratio-container">
          <div class="ratio-labels">
            <span class="label-principal" id="label-principal-pct">Invested Principal: 32.4%</span>
            <span class="label-interest" id="label-interest-pct">Interest Earned: 67.6%</span>
          </div>
          <div class="ratio-bar" role="progressbar" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100">
            <div class="bar-segment bar-segment--principal" id="bar-principal" style="width: 32.4%;"></div>
            <div class="bar-segment bar-segment--interest" id="bar-interest" style="width: 67.6%;"></div>
          </div>
        </div>

        <!-- Interactive SVG Growth Chart -->
        <div class="chart-container">
          <div class="chart-header">
            <h3>Growth Projection Over Time</h3>
            <div class="chart-legend">
              <span class="legend-item"><span class="legend-color legend-color--balance"></span> Total Balance</span>
              <span class="legend-item"><span class="legend-color legend-color--principal"></span> Total Invested</span>
            </div>
          </div>
          <div class="svg-chart-wrap" id="chart-wrap">
            <svg id="growth-chart" viewBox="0 0 600 240" preserveAspectRatio="none" aria-label="Compound Growth Chart">
              <defs>
                <linearGradient id="balanceGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--md-sys-color-primary, #6750A4)" stop-opacity="0.35"/>
                  <stop offset="100%" stop-color="var(--md-sys-color-primary, #6750A4)" stop-opacity="0.0"/>
                </linearGradient>
                <linearGradient id="investedGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--md-sys-color-outline, #79747E)" stop-opacity="0.25"/>
                  <stop offset="100%" stop-color="var(--md-sys-color-outline, #79747E)" stop-opacity="0.0"/>
                </linearGradient>
              </defs>
              <g id="chart-grid" stroke="var(--md-sys-color-outline-variant, #CAC4D0)" stroke-dasharray="3,3" stroke-width="1"></g>
              <path id="chart-area-invested" fill="url(#investedGrad)" d=""/>
              <path id="chart-area-balance" fill="url(#balanceGrad)" d=""/>
              <path id="chart-line-invested" fill="none" stroke="var(--md-sys-color-outline, #79747E)" stroke-width="2" stroke-dasharray="4,4" d=""/>
              <path id="chart-line-balance" fill="none" stroke="var(--md-sys-color-primary, #6750A4)" stroke-width="3" d=""/>
              <g id="chart-points"></g>
            </svg>
            <div id="chart-tooltip" class="chart-tooltip" style="display:none;"></div>
          </div>
        </div>
      </section>
    </div>

    <!-- Annual Breakdown Amortization Table -->
    <section class="table-card" aria-labelledby="heading-schedule">
      <div class="table-header">
        <div>
          <h2 id="heading-schedule">Year-by-Year Growth Schedule</h2>
          <p class="table-sub">Detailed breakdown of principal deposits, yearly interest, and year-end wealth</p>
        </div>
        <div class="table-actions">
          <button type="button" class="btn-secondary" id="btn-export-csv">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Export CSV</span>
          </button>
          <button type="button" class="btn-secondary" id="btn-copy-table">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy Table</span>
          </button>
        </div>
      </div>

      <div class="table-wrap">
        <table class="schedule-table" id="schedule-table">
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col">Starting Balance</th>
              <th scope="col">Annual Deposits</th>
              <th scope="col">Interest Earned</th>
              <th scope="col">Total Interest To Date</th>
              <th scope="col">Ending Balance</th>
            </tr>
          </thead>
          <tbody id="table-body">
            <!-- Dynamically populated via JS -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- Comprehensive Financial Guide & SEO Content -->
    <article class="guide-section">
      <h2>Understanding the Power of Compound Interest</h2>
      <p>
        Compound interest is often called the <em>snowball effect of money</em>. When you invest money, you earn interest on your
        original deposit. In the subsequent year, you earn interest not only on your deposit, but also on the interest you earned the year
        before. As time goes on, the interest component dramatically overtakes the money you deposited from your own pocket.
      </p>

      <div class="formula-box">
        <h3>The Mathematics of Compounding</h3>
        <p class="math-formula">
          <code>A = P(1 + r/n)<sup>nt</sup> + PMT × [ ((1 + r/n)<sup>nt</sup> - 1) / (r/n) ]</code>
        </p>
        <ul class="formula-legend">
          <li><strong>A</strong> = Final accumulated future value</li>
          <li><strong>P</strong> = Initial principal balance</li>
          <li><strong>r</strong> = Nominal annual interest rate (as a decimal)</li>
          <li><strong>n</strong> = Compounding frequency per year (e.g. 12 for monthly, 365 for daily)</li>
          <li><strong>t</strong> = Number of years the money is invested</li>
          <li><strong>PMT</strong> = Monthly recurring contribution amount</li>
        </ul>
      </div>

      <div class="insights-grid">
        <div class="insight-card">
          <h3>⏱️ The Rule of 72</h3>
          <p>
            A quick mental shortcut: divide 72 by your expected annual interest rate to find roughly how many years it takes your
            money to double. At an 8% return, your wealth doubles approximately every 9 years (<code>72 / 8 = 9</code>).
          </p>
        </div>
        <div class="insight-card">
          <h3>💰 The Importance of Starting Early</h3>
          <p>
            Starting at age 25 with $300/month at 8% results in over <strong>$1,050,000</strong> at age 65 (40 years). Waiting until age
            35 cuts the final sum in half to roughly $440,000, despite saving for 30 full years. Time is the most powerful variable in compounding.
          </p>
        </div>
        <div class="insight-card">
          <h3>📊 Compounding Frequency Impact</h3>
          <p>
            More frequent compounding (monthly or daily vs annual) yields slightly higher returns due to faster reinvestment of
            interest payments, maximizing your effective annual percentage yield (APY).
          </p>
        </div>
      </div>

      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>What is a realistic annual rate of return to assume?</summary>
          <p>
            Historically, broad stock market index funds like the S&P 500 have generated an average nominal return of 9%–10% per year
            over 30-year spans (around 7% after inflation). High-yield savings accounts typically range from 3% to 5%, while conservative bond
            funds typically yield 4% to 5%.
          </p>
        </details>
        <details class="faq-item">
          <summary>Does this calculator factor in inflation and taxes?</summary>
          <p>
            This calculator computes nominal values. To simulate inflation-adjusted returns, simply reduce your entered interest rate
            by estimated inflation (for instance, use 7% instead of 10% to represent purchasing power in today's dollars).
          </p>
        </details>
        <details class="faq-item">
          <summary>How does compounding frequency affect my returns?</summary>
          <p>
            The more frequently interest is calculated and added to the principal, the faster your money grows. While the difference between
            monthly and daily compounding is modest on smaller accounts, on large retirement portfolios over decades, it can result in
            thousands of dollars in additional wealth.
          </p>
        </details>
        <details class="faq-item">
          <summary>Are my financial figures stored or tracked?</summary>
          <p>
            No. All computations, graphs, and table exports are performed 100% locally inside your web browser. Nothing is sent to any server.
          </p>
        </details>
      </div>
    </article>
  </div>
</ToolLayout>

<style>
  #tool-compound-interest-calculator {
    padding: 1.5rem;
    color: var(--md-sys-color-on-surface, #1C1B1F);
    font-family: inherit;
  }

  .tool-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .tool-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--md-sys-color-on-surface, #1C1B1F);
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--md-sys-color-on-surface-variant, #49454F);
    margin: 0;
  }

  /* Quick Presets */
  .quick-presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
    background: var(--md-sys-color-surface-container, #F3EDF7);
    padding: 0.75rem 1rem;
    border-radius: 12px;
  }

  .preset-label {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--md-sys-color-on-surface-variant, #49454F);
  }

  .preset-btn {
    border: 1px solid var(--md-sys-color-outline-variant, #CAC4D0);
    background: var(--md-sys-color-surface, #FFFFFF);
    color: var(--md-sys-color-on-surface, #1C1B1F);
    padding: 0.45rem 0.85rem;
    border-radius: 20px;
    font-size: 0.82rem;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .preset-btn:hover {
    background: var(--md-sys-color-surface-container-high, #ECE6F0);
    border-color: var(--md-sys-color-primary, #6750A4);
  }

  .preset-btn.active {
    background: var(--md-sys-color-primary, #6750A4);
    color: var(--md-sys-color-on-primary, #FFFFFF);
    border-color: var(--md-sys-color-primary, #6750A4);
  }

  /* 2-Column Grid Layout */
  .calc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 900px) {
    .calc-grid {
      grid-template-columns: 380px 1fr;
    }
  }

  .calc-card {
    background: var(--md-sys-color-surface-container-low, #F7F2FA);
    border: 1px solid var(--md-sys-color-outline-variant, #CAC4D0);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
    color: var(--md-sys-color-on-surface, #1C1B1F);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Form Controls */
  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
    color: var(--md-sys-color-on-surface, #1C1B1F);
  }

  .tooltip-icon {
    font-size: 0.85rem;
    cursor: help;
    opacity: 0.7;
  }

  .input-currency {
    position: relative;
    display: flex;
    align-items: center;
  }

  .currency-symbol {
    position: absolute;
    left: 1rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant, #49454F);
    pointer-events: none;
  }

  .input-currency .form-input {
    padding-left: 2rem;
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 0.65rem 0.9rem;
    font-size: 0.95rem;
    font-family: inherit;
    border: 1px solid var(--md-sys-color-outline, #79747E);
    border-radius: 8px;
    background: var(--md-sys-color-surface, #FFFFFF);
    color: var(--md-sys-color-on-surface, #1C1B1F);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus,
  .form-select:focus {
    outline: none;
    border-color: var(--md-sys-color-primary, #6750A4);
    box-shadow: 0 0 0 3px rgba(103, 80, 164, 0.2);
  }

  .form-row {
    display: flex;
    gap: 1rem;
  }

  .half-group {
    flex: 1;
    margin-bottom: 0;
  }

  .label-with-val {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .slider-val {
    font-weight: 700;
    color: var(--md-sys-color-primary, #6750A4);
    font-size: 0.92rem;
  }

  .slider-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .range-slider {
    flex: 1;
    accent-color: var(--md-sys-color-primary, #6750A4);
    cursor: pointer;
  }

  .form-input--compact {
    width: 75px;
    padding: 0.45rem 0.5rem;
    text-align: right;
    font-weight: 600;
  }

  /* Results Card Styling */
  .highlight-stat {
    background: var(--md-sys-color-surface, #FFFFFF);
    border: 1px solid var(--md-sys-color-outline-variant, #CAC4D0);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .stat-caption {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant, #49454F);
    display: block;
    margin-bottom: 0.25rem;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--md-sys-color-primary, #6750A4);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stat-badge {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    background: #E8F5E9;
    color: #2E7D32;
  }

