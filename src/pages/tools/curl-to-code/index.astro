    .converter-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pane {
    background: var(--md-sys-color-surface-container-lowest, #ffffff);
    border: 1px solid var(--md-sys-color-outline-variant, #cac4d0);
    border-radius: 16px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
