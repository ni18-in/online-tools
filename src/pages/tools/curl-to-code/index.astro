    justify-content: space-between;
    gap: 8px;
    margin-bottom: 0.85rem;
    min-height: 38px;
  }
  .pane-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface, #1c1b1f);
    margin: 0;
  }

  .request-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }
  .method-tag {
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
    font-family: monospace;
    font-size: 0.75rem;
    background: #e0e7ff;
    color: #3730a3;
  }
  .tag-post { background: #dcfce7; color: #166534; }
  .tag-get { background: #e0e7ff; color: #3730a3; }
  .tag-put { background: #fef9c3; color: #854d0e; }
  .tag-delete { background: #fee2e2; color: #991b1b; }
  .tag-patch { background: #fae8ff; color: #86198f; }

