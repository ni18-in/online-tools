---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { getTool, toolSeo } from '../../../data/tools';
import { SITE_URL } from '../../../data/site';

const tool = getTool('curl-to-code')!;

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Convert cURL Commands to Code',
  description: 'Easily convert cURL requests to JavaScript Fetch, Axios, Python Requests, Go, or PHP in seconds.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Paste your cURL Command',
      text: 'Copy the cURL command from your terminal, browser DevTools, or Postman and paste it into the input box.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Select Target Programming Language',
      text: 'Click on your desired language tab (JavaScript Fetch, Axios, Python Requests, HTTPX, Go, PHP, or Node.js).',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Copy and Run Code',
      text: 'Click the Copy Code button and paste the generated snippet directly into your codebase.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is my sensitive API data or token safe when using this tool?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, 100%. The conversion runs entirely client-side inside your browser via local JavaScript. No URLs, auth tokens, headers, or request payloads are ever sent to any remote server.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which cURL flags are supported?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The converter supports standard HTTP methods (-X, --request), headers (-H, --header), JSON and form payloads (-d, --data, --data-raw, --data-binary), basic authentication (-u, --user), cookies (-b, --cookie), and user-agents (-A, --user-agent).',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I copy a cURL command from Chrome DevTools?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Open Chrome DevTools (F12), switch to the Network tab, right-click on any network request, select Copy, and click "Copy as cURL (bash)". Then paste it here.',
      },
    },
  ],
};

const seo = toolSeo(tool, {
  title: 'cURL to Code Converter – Fetch, Axios, Python, Go & PHP',
  description:
    'Convert cURL commands to JavaScript Fetch, Axios, Python Requests, HTTPX, Go, PHP, and Node.js instantly. 100% private, local in-browser converter.',
  keywords:
    'curl to code, curl to fetch, curl to python, curl to axios, curl converter, curl to go, curl to php, convert curl to javascript, api request generator',
  author: 'ni18',
  appSchema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'cURL to Code Converter',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    url: `${SITE_URL}/tools/curl-to-code/`,
    description:
      'Instantly convert cURL command line requests into JavaScript, Python, Go, and PHP code with full header, body, and query parameter fidelity.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  extraJsonLd: [howToSchema, faqSchema],
});

const altLinks = {
  es: `${SITE_URL}/es/tools/curl-a-codigo/`,
  fr: `${SITE_URL}/fr/tools/curl-en-code/`,
};
---

<ToolLayout seo={seo} lang="en" altLinks={altLinks}>
  <div class="tool-island" id="tool-curl-to-code">
    <header class="tool-header">
      <h1>cURL to Code Converter</h1>
      <p class="subtitle">Convert cURL command lines into clean, production-ready code in 7 languages</p>
    </header>

    <div class="quick-actions">
      <button type="button" class="action-btn" id="btn-sample-json">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>Sample POST (JSON API)</span>
      </button>
      <button type="button" class="action-btn" id="btn-sample-auth">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Sample GET (Bearer Auth)</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-clear">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        <span>Clear</span>
      </button>
    </div>

    <div class="converter-grid">
      <!-- Input Column -->
      <section class="pane input-pane" aria-labelledby="input-heading">
        <div class="pane-header">
          <h2 id="input-heading">cURL Command</h2>
          <div class="request-meta" id="request-meta">
            <span class="method-tag tag-post" id="tag-method">POST</span>
            <span class="url-preview" id="url-preview" title="Detected endpoint">https://api.example.com</span>
          </div>
        </div>
        <div class="input-wrap">
          <textarea
            id="curl-input"
            class="code-textarea"
            placeholder="Paste your curl command here... Example:&#10;curl -X POST https://api.example.com/items \&#10;  -H 'Content-Type: application/json' \&#10;  -d '{&quot;name&quot;: &quot;Widget&quot;, &quot;price&quot;: 29.99}'"
            spellcheck="false"
            aria-label="cURL Command Input"
          ></textarea>
        </div>
        <div id="parse-error" class="error-banner" style="display:none;" role="alert">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span id="error-message">Invalid cURL command syntax.</span>
        </div>
      </section>

      <!-- Output Column -->
      <section class="pane output-pane" aria-labelledby="output-heading">
        <div class="pane-header">
          <h2 id="output-heading" class="sr-only">Generated Code</h2>
          <div class="lang-tabs" role="tablist" aria-label="Target language options">
            <button type="button" class="lang-tab active" data-lang="fetch" role="tab" aria-selected="true">JS Fetch</button>
            <button type="button" class="lang-tab" data-lang="axios" role="tab" aria-selected="false">Axios</button>
            <button type="button" class="lang-tab" data-lang="python-requests" role="tab" aria-selected="false">Python (Req)</button>
            <button type="button" class="lang-tab" data-lang="python-httpx" role="tab" aria-selected="false">Python (HTTPX)</button>
            <button type="button" class="lang-tab" data-lang="node" role="tab" aria-selected="false">Node.js</button>
            <button type="button" class="lang-tab" data-lang="go" role="tab" aria-selected="false">Go</button>
            <button type="button" class="lang-tab" data-lang="php" role="tab" aria-selected="false">PHP</button>
          </div>
          <button type="button" class="copy-btn" id="btn-copy-code" aria-label="Copy code to clipboard">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy Code</span>
          </button>
        </div>
        <div class="output-wrap">
          <pre class="code-pre"><code id="code-output" class="code-content"></code></pre>
        </div>
      </section>
    </div>

    <!-- SEO Content & Guide -->
    <article class="guide-section">
      <h2>How to Use the cURL to Code Converter</h2>
      <p>
        cURL is the universal command-line standard for executing HTTP API requests, but integrating those requests into
        production code requires translating arguments into your language's native HTTP library. This tool parses your cURL
        flags, extracts headers, authentication credentials, query parameters, and request bodies, and converts them into
        idiomatic snippets.
      </p>

      <div class="features-grid">
        <div class="feature-card">
          <h3>⚡ 100% Client-Side Privacy</h3>
          <p>Your API keys, bearer tokens, passwords, and payloads stay private. Nothing is transmitted over the internet or logged to any server.</p>
        </div>
        <div class="feature-card">
          <h3>🎯 7 Frameworks & Languages</h3>
          <p>Output ready-to-use code for modern JavaScript (Fetch API, Axios), Python (Requests, modern async HTTPX), Node.js, Go (net/http), and PHP cURL.</p>
        </div>
        <div class="feature-card">
          <h3>🛠️ Robust Flag Parsing</h3>
          <p>Supports multiline shell scripts with backslashes, quoted strings, basic auth (<code>-u</code>), JSON bodies, form encodings, custom headers, and cookies.</p>
        </div>
      </div>

      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How do I extract a cURL request from Chrome, Firefox, or Safari?</summary>
          <p>Press <code>F12</code> to open DevTools, select the <strong>Network</strong> tab, interact with the website to make the API call, right-click the network entry in the list, navigate to <strong>Copy</strong>, and choose <strong>Copy as cURL</strong>.</p>
        </details>
        <details class="faq-item">
          <summary>Does this tool support basic authentication and bearer tokens?</summary>
          <p>Yes. If your cURL command contains <code>-u username:password</code>, it is converted into standard HTTP Basic Authorization. Bearer tokens supplied via <code>-H "Authorization: Bearer ..."</code> are preserved across all generated snippets.</p>
        </details>
        <details class="faq-item">
          <summary>Can this tool parse multiline cURL commands copied from terminals?</summary>
          <p>Yes. Commands formatted with shell line breaks (e.g. <code>\</code> at the end of each line) or Windows PowerShell backticks are automatically normalized and parsed.</p>
        </details>
      </div>
    </article>
  </div>
</ToolLayout>

<style>
