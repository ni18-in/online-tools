<script is:inline>
  (function () {
    const curlInput = document.getElementById('curl-input');
    const codeOutput = document.getElementById('code-output');
    const tagMethod = document.getElementById('tag-method');
    const urlPreview = document.getElementById('url-preview');
    const parseError = document.getElementById('parse-error');
    const btnCopy = document.getElementById('btn-copy-code');
    const btnSampleJson = document.getElementById('btn-sample-json');
    const btnSampleAuth = document.getElementById('btn-sample-auth');
    const btnClear = document.getElementById('btn-clear');
    const langTabs = document.querySelectorAll('.lang-tab');

    let currentTarget = 'fetch';

    const SAMPLE_JSON = `curl -X POST "https://api.example.com/v1/users" \\
  -H "Content-Type: application/json" \\
  -H "Authorization: Bearer my_secret_token_123" \\
  -d '{
    "name": "Jane Doe",
    "email": "jane@example.com",
    "role": "admin"
  }'`;

    const SAMPLE_AUTH = `curl -X GET "https://api.github.com/user/repos?type=owner&sort=updated" \\
  -H "Accept: application/vnd.github.v3+json" \\
  -H "Authorization: token ghp_99482194829148" \\
  -A "MyApp/1.0"`;

    function parseCurlCommand(raw) {
      if (!raw || !raw.trim()) {
        return null;
      }
      let cmd = raw.trim();
      if (cmd.startsWith('$')) cmd = cmd.slice(1).trim();

      // Normalize escaped linebreaks
      cmd = cmd.replace(/\\\r?\n/g, ' ').replace(/`\r?\n/g, ' ');

      const tokens = [];
      let current = '';
      let inQuote = null;
      let escape = false;

      for (let i = 0; i < cmd.length; i++) {
        const char = cmd[i];
        if (escape) {
          current += char;
          escape = false;
          continue;
        }
        if (char === '\\') {
          escape = true;
          continue;
        }
        if (inQuote) {
          if (char === inQuote) {
            inQuote = null;
          } else {
            current += char;
          }
        } else {
          if (char === '"' || char === "'") {
            inQuote = char;
          } else if (/\s/.test(char)) {
            if (current) {
              tokens.push(current);
              current = '';
            }
          } else {
            current += char;
          }
        }
      }
      if (current) tokens.push(current);

      if (tokens.length === 0) return null;

      const result = {
        url: '',
        method: 'GET',
        headers: {},
        data: '',
        auth: null
      };

      for (let i = 0; i < tokens.length; i++) {
        const t = tokens[i];
        if (t === '-X' || t === '--request') {
          if (tokens[i + 1]) result.method = tokens[++i].toUpperCase();
        } else if (t === '-H' || t === '--header') {
          const h = tokens[++i] || '';
          const sep = h.indexOf(':');
          if (sep > -1) {
            const k = h.slice(0, sep).trim();
            const v = h.slice(sep + 1).trim();
            result.headers[k] = v;
          }
        } else if (t === '-d' || t === '--data' || t === '--data-raw' || t === '--data-binary') {
          const d = tokens[++i] || '';
          result.data = result.data ? result.data + '&' + d : d;
          if (result.method === 'GET') result.method = 'POST';
        } else if (t === '-u' || t === '--user') {
          result.auth = tokens[++i] || '';
        } else if (t === '-A' || t === '--user-agent') {
          result.headers['User-Agent'] = tokens[++i] || '';
        } else if (t === '-b' || t === '--cookie') {
          result.headers['Cookie'] = tokens[++i] || '';
        } else if (t === '--url') {
          result.url = tokens[++i] || '';
        } else if (!t.startsWith('-') && t !== 'curl' && !result.url) {
          result.url = t;
        }
      }

      if (result.auth) {
        result.headers['Authorization'] = 'Basic ' + btoa(result.auth);
      }

      if (!result.url) {
        result.url = 'https://api.example.com/endpoint';
      }

      return result;
    }

    function isJsonString(str) {
      if (!str || typeof str !== 'string') return false;
      const s = str.trim();
      if (!((s.startsWith('{') && s.endsWith('}')) || (s.startsWith('[') && s.endsWith(']')))) return false;
      try {
        JSON.parse(s);
        return true;
      } catch (e) {
        return false;
      }
    }

    function generateCode(parsed, target) {
      if (!parsed) return '// Paste a cURL command above to generate code';

      const url = parsed.url;
      const method = parsed.method || 'GET';
      const headers = parsed.headers || {};
      const hasHeaders = Object.keys(headers).length > 0;
      const hasBody = Boolean(parsed.data);
      const isJson = isJsonString(parsed.data);

      switch (target) {
        case 'fetch': {
          let opts = `{\n  method: '${method}'`;
          if (hasHeaders) {
            opts += `,\n  headers: ${JSON.stringify(headers, null, 4).replace(/\n/g, '\n  ')}`;
          }
          if (hasBody) {
            if (isJson) {
              opts += `,\n  body: JSON.stringify(${JSON.stringify(JSON.parse(parsed.data), null, 4).replace(/\n/g, '\n  ')})`;
            } else {
              opts += `,\n  body: ${JSON.stringify(parsed.data)}`;
            }
          }
          opts += '\n}';

          return `const url = '${url}';\nconst options = ${opts};\n\ntry {\n  const response = await fetch(url, options);\n  const data = await response.json();\n  console.log(data);\n} catch (error) {\n  console.error('Fetch Error:', error);\n}`;
        }

        case 'axios': {
          let code = `const axios = require('axios');\n\nconst config = {\n  method: '${method.toLowerCase()}',\n  url: '${url}'`;
          if (hasHeaders) {
            code += `,\n  headers: ${JSON.stringify(headers, null, 4).replace(/\n/g, '\n  ')}`;
          }
          if (hasBody) {
            if (isJson) {
              code += `,\n  data: ${JSON.stringify(JSON.parse(parsed.data), null, 4).replace(/\n/g, '\n  ')}`;
            } else {
              code += `,\n  data: ${JSON.stringify(parsed.data)}`;
            }
          }
          code += '\n};\n\naxios(config)\n  .then(response => console.log(response.data))\n  .catch(error => console.error(error));';
          return code;
        }

        case 'python-requests': {
          let code = `import requests\n\nurl = "${url}"\n`;
          let args = ['url'];

          if (hasHeaders) {
            code += `headers = ${JSON.stringify(headers, null, 4)}\n`;
            args.push('headers=headers');
          }
          if (hasBody) {
            if (isJson) {
              code += `payload = ${JSON.stringify(JSON.parse(parsed.data), null, 4)}\n`;
              args.push('json=payload');
            } else {
              code += `payload = ${JSON.stringify(parsed.data)}\n`;
              args.push('data=payload');
            }
          }

          code += `\nresponse = requests.${method.toLowerCase()}(${args.join(', ')})\nprint(response.status_code)\nprint(response.text)`;
          return code;
        }

        case 'python-httpx': {
          let code = `import httpx\n\nurl = "${url}"\n`;
          let args = ['url'];

          if (hasHeaders) {
            code += `headers = ${JSON.stringify(headers, null, 4)}\n`;
            args.push('headers=headers');
          }
          if (hasBody) {
            if (isJson) {
              code += `payload = ${JSON.stringify(JSON.parse(parsed.data), null, 4)}\n`;
              args.push('json=payload');
            } else {
              code += `payload = ${JSON.stringify(parsed.data)}\n`;
              args.push('data=payload');
            }
          }

          code += `\nwith httpx.Client() as client:\n    response = client.${method.toLowerCase()}(${args.join(', ')})\n    print(response.status_code)\n    print(response.text)`;
          return code;
        }

        case 'node': {
          let opts = `{\n  method: '${method}'`;
          if (hasHeaders) {
            opts += `,\n  headers: ${JSON.stringify(headers, null, 4).replace(/\n/g, '\n  ')}`;
          }
          if (hasBody) {
            if (isJson) {
              opts += `,\n  body: JSON.stringify(${JSON.stringify(JSON.parse(parsed.data), null, 4).replace(/\n/g, '\n  ')})`;
            } else {
              opts += `,\n  body: ${JSON.stringify(parsed.data)}`;
            }
          }
          opts += '\n}';

          return `// Node.js 18+ native fetch\nconst response = await fetch('${url}', ${opts});\nconst result = await response.json();\nconsole.log(result);`;
        }

        case 'go': {
          let code = `package main\n\nimport (\n\t"fmt"\n\t"io"\n\t"net/http"\n`;
          if (hasBody) code += `\t"strings"\n`;
          code += `)\n\nfunc main() {\n\turl := "${url}"\n`;

          if (hasBody) {
            code += `\tpayload := strings.NewReader(${JSON.stringify(parsed.data)})\n`;
            code += `\treq, err := http.NewRequest("${method}", url, payload)\n`;
          } else {
            code += `\treq, err := http.NewRequest("${method}", url, nil)\n`;
          }

          code += `\tif err != nil {\n\t\tpanic(err)\n\t}\n\n`;

          for (const [k, v] of Object.entries(headers)) {
            code += `\treq.Header.Set("${k}", "${v}")\n`;
          }

          code += `\n\tclient := &http.Client{}\n\tresp, err := client.Do(req)\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tdefer resp.Body.Close()\n\n\tbody, _ := io.ReadAll(resp.Body)\n\tfmt.Println(string(body))\n}`;
          return code;
        }

        case 'php': {
          let code = `<?php\n$curl = curl_init();\n\ncurl_setopt_array($curl, array(\n  CURLOPT_URL => '${url}',\n  CURLOPT_RETURNTRANSFER => true,\n  CURLOPT_ENCODING => '',\n  CURLOPT_MAXREDIRS => 10,\n  CURLOPT_TIMEOUT => 0,\n  CURLOPT_FOLLOWLOCATION => true,\n  CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,\n  CURLOPT_CUSTOMREQUEST => '${method}',\n`;

          if (hasBody) {
            code += `  CURLOPT_POSTFIELDS => ${JSON.stringify(parsed.data)},\n`;
          }

          if (hasHeaders) {
            const hList = Object.entries(headers).map(([k, v]) => `    '${k}: ${v}'`);
            code += `  CURLOPT_HTTPHEADER => array(\n${hList.join(',\n')}\n  ),\n`;
          }

          code += `));\n\n$response = curl_exec($curl);\ncurl_close($curl);\necho $response;\n?>`;
          return code;
        }

        default:
          return '// Unsupported language target';
      }
    }

    function update() {
      const raw = curlInput.value.trim();
      if (!raw) {
        tagMethod.textContent = 'POST';
        tagMethod.className = 'method-tag tag-post';
        urlPreview.textContent = 'https://api.example.com';
        codeOutput.textContent = '// Paste a cURL command above to generate code';
        parseError.style.display = 'none';
        return;
      }

      try {
        const parsed = parseCurlCommand(raw);
        if (!parsed) throw new Error('Could not parse cURL');

        tagMethod.textContent = parsed.method;
        tagMethod.className = `method-tag tag-${parsed.method.toLowerCase()}`;
        urlPreview.textContent = parsed.url;
        urlPreview.title = parsed.url;
        parseError.style.display = 'none';

        const code = generateCode(parsed, currentTarget);
        codeOutput.textContent = code;

        try {
          localStorage.setItem('onlineTools_curlInput', raw);
        } catch (e) {}
      } catch (err) {
        parseError.style.display = 'flex';
      }
    }

    curlInput.addEventListener('input', update);

    langTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        langTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        currentTarget = tab.getAttribute('data-lang');
        update();
      });
    });

    btnSampleJson.addEventListener('click', () => {
      curlInput.value = SAMPLE_JSON;
      update();
    });

    btnSampleAuth.addEventListener('click', () => {
      curlInput.value = SAMPLE_AUTH;
      update();
    });

    btnClear.addEventListener('click', () => {
      curlInput.value = '';
      update();
      curlInput.focus();
    });

    btnCopy.addEventListener('click', () => {
      const code = codeOutput.textContent;
      if (!code || code.startsWith('// Paste a cURL')) return;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).then(() => {
          if (window.showToast) window.showToast('Copied code to clipboard!');
        });
      } else {
        const ta = document.createElement('textarea');
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        if (window.showToast) window.showToast('Copied code to clipboard!');
      }
    });

    // Restore from localStorage or load sample
    const saved = localStorage.getItem('onlineTools_curlInput');
    if (saved) {
      curlInput.value = saved;
    } else {
      curlInput.value = SAMPLE_JSON;
    }
    update();
  })();
</script>
