  .inspect-box { background: var(--md-sys-color-surface-container-low); border: 1px solid var(--md-sys-color-outline-variant); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem; }
  .inspect-row { display: flex; justify-content: space-between; align-items: center; }
  .inspect-label { font-weight: 600; color: var(--md-sys-color-on-surface-variant); }
