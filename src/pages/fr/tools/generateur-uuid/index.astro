---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import { getTool, toolSeo, makeFaqSchema, makeHowToSchema } from '../../../../data/tools';
import { SITE_URL } from '../../../../data/site';

const tool = getTool('uuid-generator')!;

const steps = [
  {
    title: 'Sélectionner le Type d\'Identifiant et la Quantité',
    description: 'Choisissez entre UUID v4 (aléatoire), UUID v7 (trié par horodatage), ULID (triable lexicographiquement) ou NanoID. Définissez votre lot de 1 à 500 IDs.',
  },
  {
    title: 'Personnaliser le Format de Sortie',
    description: 'Activez majuscules ou minuscules, incluez ou excluez les tirets, ou entourez vos identifiants de guillemets selon vos besoins.',
  },
  {
    title: 'Inspecter et Décoder les Horodatages',
    description: 'Collez n\'importe quel UUID v7 ou ULID dans le panneau Inspecteur pour extraire instantanément son horodatage en millisecondes et sa date de création.',
  },
  {
    title: 'Copier ou Télécharger les Résultats',
    description: 'Copiez les identifiants générés dans le presse-papiers ou exportez-les sous forme de fichiers texte .txt ou de tableaux JSON structurés.',
  },
];

const faqSchema = makeFaqSchema([
  {
    question: 'Mes identifiants UUID et NanoID sont-ils privés et sécurisés ?',
    answer: 'Oui, 100%. Toute la génération, le formatage et l\'analyse s\'exécutent entièrement dans la mémoire locale de votre navigateur via l\'API Web Crypto. Aucune donnée n\'est transmise sur un serveur distant.',
  },
  {
    question: 'Quelle est la différence principale entre UUID v4 et UUID v7 ?',
    answer: 'L\'UUID v4 est totalement aléatoire avec 122 bits d\'entropie. L\'UUID v7 intègre un horodatage en millisecondes sur 48 bits au début, garantissant un tri chronologique efficace dans les bases de données.',
  },
  {
    question: 'En quoi ULID diffère-t-il de NanoID ?',
    answer: 'ULID est un identifiant de 128 bits codé en 26 caractères Base32 de Crockford incluant un horodatage. NanoID est une chaîne compacte et personnalisable (21 caractères par défaut) optimisée pour les URLs.',
  },
  {
    question: 'Puis-je extraire la date de création de n\'importe quel UUID ?',
    answer: 'Vous pouvez extraire l\'horodatage des formats temporels comme UUID v1, v6, v7 et ULID. Les formats aléatoires comme UUID v4 ne stockent pas de métadonnées temporelles.',
  },
]);

const howToSchema = makeHowToSchema(
  'Comment Générer et Inspecter des UUID, ULID et NanoID en Ligne',
  'Guide étape par étape pour générer des chaînes sécurisées UUID v4, UUID v7, ULID et NanoID avec décodage d\'horodatage.',
  steps
);

const seo = toolSeo(tool, {
  title: 'Générateur UUID et NanoID – UUID v4, v7, ULID en Lot',
  description:
    'Générez des UUID v4, v7, ULID et NanoID sécurisés en lot. Inspectez les horodatages et formatez vos identifiants avec confidentialité 100% locale.',
  keywords:
    'generateur uuid, generateur uuid v7, generateur nanoid, generateur ulid, inspecteur uuid, generateur uuid en lot, uuid trie par horodatage, outil uuid en ligne',
  author: 'ni18',
  ogTitle: 'Générateur UUID et NanoID – UUID v4, v7, ULID en Lot',
  ogDescription:
    'Générez des UUID v4, v7, ULID et NanoID sécurisés en lot. Inspectez les horodatages et formatez vos identifiants avec confidentialité 100% locale.',
  twitterDomain: 'online-tools.ni18.in',
  appSchema: {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Générateur et Inspecteur UUID et NanoID',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'All',
    url: `${SITE_URL}/fr/tools/generateur-uuid/`,
    description:
      'Générez des chaînes sécurisées UUID v4, v7, ULID et NanoID. Inspectez les horodatages sans aucun transfert vers un serveur.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  extraJsonLd: [howToSchema, faqSchema],
});
seo.canonical = `${SITE_URL}/fr/tools/generateur-uuid/`;
seo.og!.url = seo.canonical;
seo.twitter!.url = seo.canonical;

const altLinks = {
  en: `${SITE_URL}/tools/uuid-generator/`,
  es: `${SITE_URL}/es/tools/generador-uuid/`,
};
---

<ToolLayout seo={seo} lang="fr" altLinks={altLinks}>
  <div class="tool-island" id="tool-uuid-generator">
    <header class="tool-header">
      <h1>Générateur et Inspecteur UUID et NanoID</h1>
      <p class="subtitle">Génération en lot sécurisée d'UUID v4, UUID v7, ULID et NanoID avec inspection d'horodatage</p>
    </header>

    <!-- Barre d'Actions Rapides -->
    <div class="quick-actions">
      <button type="button" class="action-btn" id="btn-generate">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
        <span>Générer Nouveau Lot</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-sample">
        <span>Charger Exemple</span>
      </button>
      <button type="button" class="action-btn action-btn--secondary" id="btn-clear">
        <span>Effacer</span>
      </button>
    </div>

    <!-- Espace de Travail Principal -->
    <div class="workspace-grid">
      <!-- Configuration et Générateur -->
      <section class="pane input-pane" aria-labelledby="controls-heading-fr">
        <div class="pane-header">
          <h2 id="controls-heading-fr">Configuration et Générateur</h2>
        </div>

        <div class="control-group">
          <label for="id-type">Format d'Identifiant</label>
          <select id="id-type" class="form-select">
            <option value="v4" selected>UUID v4 (Aléatoire - RFC 4122)</option>
            <option value="v7">UUID v7 (Trié par horodatage - RFC 9562)</option>
            <option value="ulid">ULID (Triable lexicographiquement)</option>
            <option value="nanoid">NanoID (Compact pour URLs)</option>
          </select>
        </div>

        <div class="control-row">
          <div class="control-group half">
            <label for="id-count">Quantité (1 - 500)</label>
            <input type="number" id="id-count" value="10" min="1" max="500" class="form-input" />
          </div>
          <div class="control-group half" id="nanoid-length-wrap" style="display:none;">
            <label for="nanoid-length">Longueur NanoID</label>
            <input type="number" id="nanoid-length" value="21" min="6" max="64" class="form-input" />
          </div>
        </div>

        <div class="options-grid">
          <label class="checkbox-label">
            <input type="checkbox" id="opt-uppercase" />
            <span>Majuscules</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="opt-hyphens" checked />
            <span>Tirets (UUID)</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="opt-quotes" />
            <span>Entourer de guillemets</span>
          </label>
        </div>

        <div class="pane-header sub-header margin-top">
          <h2>Inspecteur UUID / ULID et Décodeur</h2>
        </div>
        <div class="control-group">
          <input type="text" id="inspect-input" class="form-input" placeholder="Collez un UUID v7 ou ULID pour extraire la date..." spellcheck="false" />
        </div>
        <div id="inspect-result" class="inspect-box">
          <div class="inspect-row"><span class="inspect-label">Format Détecté:</span> <span id="insp-format" class="badge">Aucun</span></div>
          <div class="inspect-row"><span class="inspect-label">Horodatage (UTC):</span> <span id="insp-date" class="inspect-val">-</span></div>
          <div class="inspect-row"><span class="inspect-label">Époque Unix:</span> <span id="insp-epoch" class="inspect-val">-</span></div>
        </div>

        <div id="status-error" class="error-banner" style="display:none;" role="alert">
          <span id="error-message">Configuration ou format d'ID invalide.</span>
        </div>
      </section>

      <!-- Section de Sortie -->
      <section class="pane output-pane" aria-labelledby="output-heading-fr">
        <div class="pane-header">
          <h2 id="output-heading-fr">Résultats Générés</h2>
          <div class="output-actions">
            <button type="button" class="copy-btn" id="btn-copy"><span>Copier Tout</span></button>
            <button type="button" class="copy-btn action-btn--secondary" id="btn-download-txt"><span>.TXT</span></button>
            <button type="button" class="copy-btn action-btn--secondary" id="btn-download-json"><span>.JSON</span></button>
          </div>
        </div>
        <div class="output-wrap">
          <textarea id="output-text" class="output-textarea" readonly spellcheck="false"></textarea>
        </div>
        <div class="output-meta">
          <span id="output-count-badge" class="count-badge">0 IDs générés</span>
        </div>
      </section>
    </div>

    <!-- Guide Éducatif et FAQ -->
    <article class="guide-section">
      <h2>Comment Utiliser le Générateur UUID et NanoID</h2>
      <p>Que vous conceviez des schémas de base de données, configuriez des API ou génériez des jetons de session, le choix de l'identifiant est essentiel. Cet outil génère des IDs sécurisés et inspecte les horodatages directement dans votre navigateur.</p>

      <div class="features-grid">
        <div class="feature-card">
          <h3>⚡ Confidentialité Web Crypto 100% Locale</h3>
          <p>Utilise l'API native <code>crypto.getRandomValues</code> pour une entropie maximale. Aucune donnée n'est envoyée vers un serveur externe.</p>
        </div>
        <div class="feature-card">
          <h3>⏱️ Extraction d'Horodatage UUID v7 et ULID</h3>
          <p>Décodez les horodatages précis en millisecondes depuis les identifiants triables (UUID v7 et ULID) pour vérifier la date exacte de création.</p>
        </div>
        <div class="feature-card">
          <h3>📦 Exportation en Lot et Options</h3>
          <p>Générez jusqu'à 500 identifiants simultanément. Personnalisez la casse, les tirets ou guillemets et exportez au format .TXT ou .JSON.</p>
        </div>
      </div>

      <h2>Instructions Étape par Étape</h2>
      <ol class="steps-list">
        <li><strong>Étape 1 : Choisissez le Format :</strong> Sélectionnez UUID v4 pour des identifiants aléatoires, UUID v7 ou ULID pour des clés chronologiques, ou NanoID pour des URLs compactes.</li>
        <li><strong>Étape 2 : Configurez les Options :</strong> Définissez la quantité souhaitée et activez les majuscules, tirets ou guillemets selon vos préférences.</li>
        <li><strong>Étape 3 : Copiez ou Exportez :</strong> Copiez les résultats ou téléchargez des fichiers au format .TXT ou .JSON.</li>
        <li><strong>Étape 4 : Inspectez les Identifiants :</strong> Collez un UUID v7 ou ULID dans l'inspecteur pour afficher sa date de création en UTC.</li>
      </ol>

      <h2>Analyse Technique : UUID v4 vs UUID v7 vs ULID</h2>
      <p>Traditionnellement, <strong>UUID v4</strong> (RFC 4122) est le standard par défaut. Cependant, son absence d'ordre chronologique entraîne une fragmentation des index B-tree dans les bases de données lors d'insertions massives.</p>

      <p><strong>UUID v7</strong> (RFC 9562) résout ce problème en intégrant un horodatage Unix de 48 bits, garantissant un tri séquentiel fluide qui préserve les performances d'écriture.</p>

      <p>De même, <strong>ULID</strong> utilise 128 bits codés en Base32 de Crockford avec horodatage, tandis que <strong>NanoID</strong> offre des chaînes plus courtes adaptées aux URLs avec une résistance élevée aux collisions.</p>

      <h2>Foire Aux Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Mes données générées sont-elles confidentielles ?</summary>
          <p>Oui, 100%. Tout le traitement s'effectue dans la mémoire locale de votre navigateur. Aucun réseau ni serveur n'est sollicité.</p>
        </details>
        <details class="faq-item">
          <summary>Quand utiliser UUID v7 plutôt que UUID v4 ?</summary>
          <p>Utilisez UUID v7 pour les clés primaires de bases de données relationnelles afin d'éviter la fragmentation des index.</p>
        </details>
        <details class="faq-item">
          <summary>NanoID peut-il remplacer UUID v4 ?</summary>
          <p>Oui. NanoID produit des chaînes plus courtes (21 caractères contre 36) très adaptées aux URLs tout en maintenant une excellente entropie.</p>
        </details>
        <details class="faq-item">
          <summary>Comment fonctionne le décodage d'horodatage en UUID v7 ?</summary>
          <p>Les 48 premiers bits représentent l'horodatage Unix en millisecondes. L'inspecteur extrait ces bits et les convertit en une date UTC lisible.</p>
        </details>
      </div>
    </article>
  </div>
</ToolLayout>

<style>
  #tool-uuid-generator { max-width: 1080px; margin: 0 auto; }
  .tool-header { text-align: center; margin-bottom: 24px; }
  .tool-header h1 { font-size: clamp(1.75rem, 4vw, 2.25rem); font-weight: 700; margin: 0 0 8px; color: var(--md-sys-color-on-surface); }
  .subtitle { font-size: 1rem; color: var(--md-sys-color-on-surface-variant); margin: 0; }

  .quick-actions { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; justify-content: center; }
  .action-btn, .copy-btn {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
    border-radius: var(--md-sys-shape-corner-small, 8px); font-size: 0.875rem; font-weight: 500;
    cursor: pointer; border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface-container-high); color: var(--md-sys-color-on-surface);
    transition: background 0.15s, border-color 0.15s;
  }
  .action-btn:hover, .copy-btn:hover { background: var(--md-sys-color-surface-container-highest); border-color: var(--md-sys-color-primary); }
  .action-btn--secondary { background: var(--md-sys-color-surface-container-low); }

  .workspace-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 36px; }
  .pane { background: var(--md-sys-color-surface-container-lowest); border: 1px solid var(--md-sys-color-outline-variant); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; }
  .pane-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px; }
  .pane-header h2 { font-size: 1.1rem; font-weight: 600; margin: 0; color: var(--md-sys-color-on-surface); }
  .sub-header { border-top: 1px solid var(--md-sys-color-outline-variant); padding-top: 16px; }
  .margin-top { margin-top: 20px; }

  .control-group { margin-bottom: 14px; display: flex; flex-direction: column; gap: 6px; }
  .control-group label { font-size: 0.85rem; font-weight: 600; color: var(--md-sys-color-on-surface-variant); }
  .control-row { display: flex; gap: 12px; }
  .control-row .half { flex: 1; }

  .form-select, .form-input {
    width: 100%; padding: 10px 12px; border-radius: 8px;
    border: 1px solid var(--md-sys-color-outline-variant);
    background: var(--md-sys-color-surface); color: var(--md-sys-color-on-surface);
