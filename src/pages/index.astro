---
import PageLayout from '../layouts/PageLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import type { Props as SeoProps } from '../components/Seo.astro';
import { SITE_URL, DEFAULT_OG_IMAGE } from '../data/site';
import { homepageGrid, homepageItemListOrder, getTool, toolUrl, homepageItemListItem } from '../data/tools';

const collectionItems = homepageItemListOrder.map((slug, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  item: homepageItemListItem(getTool(slug)!),
}));

const seo: SeoProps = {
  title: 'Online Tools | Free Web Utilities, Calculators & Converters',
  description:
    'Your go-to hub for free online tools. Access calculators, text utilities, converters, and more useful web apps directly in your browser. Simple and easy to use.',
  canonical: `${SITE_URL}/`,
  keywords:
    'online tools, free web utilities, calculators, converters, image editor, json visualizer, text analyzer, developer tools',
  hreflang: [
    { hreflang: 'en', href: `${SITE_URL}/` },
    { hreflang: 'es', href: `${SITE_URL}/es/` },
    { hreflang: 'fr', href: `${SITE_URL}/fr/` },
    { hreflang: 'x-default', href: `${SITE_URL}/` },
  ],
  og: {
    type: 'website',
    url: `${SITE_URL}/`,
    title: 'Online Tools | Free Web Utilities, Calculators & Converters',
    description: 'A collection of handy, free online tools like calculators, text analyzers, and converters.',
    image: DEFAULT_OG_IMAGE,
    siteName: 'Online Tools',
    locale: 'en_US',
  },
  twitter: {
    card: 'summary_large_image',
    url: `${SITE_URL}/`,
    title: 'Online Tools | Free Web Utilities & Apps',
    description: 'A collection of handy, free online tools like calculators, text analyzers, and converters.',
    image: DEFAULT_OG_IMAGE,
  },
  jsonLd: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Online Tools',
      alternateName: 'Online Web Tools and Utilities',
      url: `${SITE_URL}/`,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Online Tools - Free Web Utilities, Calculators & Converters',
      description:
        'A curated list of free online tools including calculators, text utilities, converters, and more, accessible directly via your browser.',
      url: `${SITE_URL}/`,
      mainEntity: { '@type': 'ItemList', itemListElement: collectionItems },
    },
  ],
};

// Resolve the grid into render-ready cards (preserving exact order).
const cards = homepageGrid.map((entry) => {
  if (typeof entry === 'string') {
    const t = getTool(entry)!;
    return { href: toolUrl(t.slug).replace(SITE_URL, ''), name: t.name, description: t.description, category: t.category, external: false };
  }
  return { href: entry.external, name: entry.name, description: entry.description, category: 'fun', external: true };
});

const filterCategories = [
  { id: 'all', label: 'All Tools' },
  { id: 'developer', label: 'Developer' },
  { id: 'text', label: 'Text & Content' },
  { id: 'media', label: 'Media & Images' },
  { id: 'calculator', label: 'Calculators' },
  { id: 'fun', label: 'Fun & Games' },
];
---
<PageLayout seo={seo} lang="en" current="home" adsEnabled={true}>
  <section class="hero">
    <h1>Free Online Tools</h1>
    <p>Calculators, converters, and developer utilities — fast, private, and right in your browser.</p>
  </section>

  <section aria-labelledby="search-heading" class="search">
    <h2 id="search-heading" class="sr-only">Search Tools</h2>
    <form role="search" id="tool-search-form" onsubmit="return false;">
      <label for="tool-search-input" class="sr-only">Search for tools</label>
      <div class="search-input-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="search" id="tool-search-input" name="q" placeholder="Search tools by name or description... (Press /)" autocomplete="off" />
        <button type="button" id="clear-search-btn" class="clear-search-btn" aria-label="Clear search" style="display:none">&times;</button>
        <div class="shortcut-hint" aria-hidden="true"><kbd>/</kbd></div>
      </div>
    </form>
  </section>

  <div class="category-pills" role="tablist" aria-label="Filter tools by category">
    {filterCategories.map((cat, idx) => (
      <button
        type="button"
        class:list={['pill-btn', { active: idx === 0 }]}
        data-category-filter={cat.id}
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
      >
        {cat.label}
      </button>
    ))}
  </div>

  <section aria-labelledby="tool-list-heading">
    <h2 id="tool-list-heading" class="section-title">Available Tools</h2>
    <div id="no-results-message" class="no-results-card" style="display:none" aria-live="polite">
      <div class="no-results-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <h3>No tools found</h3>
      <p id="no-results-query-text">No tools matching your search criteria were found.</p>
      <button type="button" id="reset-search-btn" class="reset-search-btn">View All Tools</button>
    </div>
    <div class="tool-grid">
      {cards.map((c, i) => (
        <ToolCard
          href={c.href}
          name={c.name}
          description={c.description}
          category={c.category}
          headingId={`tool-heading-${i + 1}`}
          external={c.external}
        />
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      var input = document.getElementById('tool-search-input');
      var pills = Array.prototype.slice.call(document.querySelectorAll('[data-category-filter]'));
      var cards = Array.prototype.slice.call(document.querySelectorAll('.tool-card'));
      var noResults = document.getElementById('no-results-message');
      var clearBtn = document.getElementById('clear-search-btn');
      var resetBtn = document.getElementById('reset-search-btn');
      if (!cards.length) return;

      var activeCat = 'all';

      function filterTools() {
        var q = input ? input.value.toLowerCase().trim() : '';
        var found = 0;
        if (clearBtn) clearBtn.style.display = q ? 'inline-flex' : 'none';

        cards.forEach(function (card) {
          var a = card.querySelector('h3 a');
          var p = card.querySelector('p');
          var title = ((a && a.textContent) || '').toLowerCase();
          var desc = ((p && p.textContent) || '').toLowerCase();
          var cardCat = card.getAttribute('data-category') || '';

          var matchCat = activeCat === 'all' || cardCat === activeCat;
          var matchSearch = !q || title.indexOf(q) !== -1 || desc.indexOf(q) !== -1;

          var visible = matchCat && matchSearch;
          card.style.display = visible ? '' : 'none';
          if (visible) found++;
        });

        if (noResults) noResults.style.display = found === 0 ? 'block' : 'none';
      }

      function resetSearch() {
        if (input) input.value = '';
        activeCat = 'all';
        pills.forEach(function (p, idx) {
          p.classList.toggle('active', idx === 0);
          p.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
        });
        filterTools();
        if (input) input.focus();
      }

      if (input) input.addEventListener('input', filterTools);
      if (clearBtn) clearBtn.addEventListener('click', resetSearch);
      if (resetBtn) resetBtn.addEventListener('click', resetSearch);

      // Keyboard shortcut: '/' or 'Ctrl+K'
      document.addEventListener('keydown', function(e) {
        if ((e.key === '/' || (e.key === 'k' && (e.ctrlKey || e.metaKey))) && document.activeElement !== input) {
          var tag = document.activeElement ? document.activeElement.tagName : '';
          if (tag !== 'INPUT' && tag !== 'TEXTAREA') {
            e.preventDefault();
            if (input) {
              input.focus();
              input.select();
            }
          }
        }
      });

      pills.forEach(function (btn) {
        btn.addEventListener('click', function () {
          pills.forEach(function (p) {
            p.classList.remove('active');
            p.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          activeCat = btn.getAttribute('data-category-filter') || 'all';
          filterTools();
        });
      });
    })();
  </script>
</PageLayout>

<style>
  .hero { text-align: center; padding: 24px 0 8px; }
  .hero h1 { font-size: 2.25rem; margin: 0 0 8px; color: var(--md-sys-color-on-surface); }
  .hero p { margin: 0 auto; max-width: 38rem; color: var(--md-sys-color-on-surface-variant); }
  .search { max-width: 42rem; margin: 24px auto 12px; }
  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .search-icon {
    position: absolute;
    left: 18px;
    color: var(--md-sys-color-on-surface-variant);
    pointer-events: none;
    opacity: 0.7;
  }
  #tool-search-input {
    width: 100%;
    padding: 14px 76px 14px 48px;
    font-size: 1rem;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: 999px;
    background: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-surface);
    transition: border-color .2s, box-shadow .2s;
  }
  #tool-search-input:focus {
    outline: none;
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-sys-color-primary) 20%, transparent);
  }
  .clear-search-btn {
    position: absolute;
    right: 44px;
    background: none;
    border: none;
    font-size: 1.25rem;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 50%;
    line-height: 1;
  }
  .clear-search-btn:hover { color: var(--md-sys-color-on-surface); }
  .shortcut-hint {
    position: absolute;
    right: 16px;
    pointer-events: none;
  }
  .shortcut-hint kbd {
    display: inline-block;
    padding: 2px 7px;
    font-size: 0.75rem;
    font-family: inherit;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 6px;
    box-shadow: 0 1px 1px rgba(0,0,0,0.1);
  }
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 8px auto 28px;
    max-width: 50rem;
  }
  .pill-btn {
    padding: 8px 16px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: 999px;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .pill-btn:hover {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    border-color: var(--md-sys-color-outline);
  }
  .pill-btn.active {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border-color: var(--md-sys-color-primary);
    box-shadow: var(--md-sys-elevation-1);
  }
  .section-title { text-align: center; font-size: 1.75rem; margin: 16px 0 24px; color: var(--md-sys-color-on-surface); }
  .no-results-card {
    text-align: center;
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px dashed var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 48px 24px;
    margin: 20px 0 32px;
  }
  .no-results-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 16px;
  }
  .no-results-card h3 {
    margin: 0 0 8px;
    font-size: 1.25rem;
    color: var(--md-sys-color-on-surface);
  }
  .no-results-card p {
    margin: 0 0 20px;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.9375rem;
  }
  .reset-search-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    border: none;
    cursor: pointer;
    transition: opacity .15s;
  }
  .reset-search-btn:hover { opacity: 0.9; }
  .tool-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 640px) { .tool-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .tool-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
