{
  "name": "online-tools",
  "version": "1.0.0",
  "description": "A collection of free, privacy-respecting browser-based utility tools. Everything runs client-side — no uploads, no server processing. Built with Astro + Material Web Components.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "verify:build": "node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "test:lh": "lhci autorun",
    "verify": "npm run build && npm run verify:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ni18-in/online-tools.git"
  },
  "keywords": [
    "online-tools",
    "client-side",
    "astro",
    "material-web",
    "static-site"
  ],
  "author": "ni18",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ni18-in/online-tools/issues"
  },
  "homepage": "https://online-tools.ni18.in",
  "dependencies": {
    "@material/web": "^2.4.1",
    "astro": "^6.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "autoprefixer": "^10.5.0"
  }
}
